use uo;
use os;
use datafile;

include ":datafile:datafile";
include "include/bounty";
include ":containers:storageAreas";

program collectBounty(parms)
  print("P: " + parms);
  var me   := parms[1];
  var who  := parms[2];
  var item := parms[3];
  if(!ReserveItem(item))
    print("!");
    return;
  endif
  var serial := GetObjProperty(item, "serial");
  var bounty := FindBounty(who, serial);
  if(!bounty)
    PrintTextAbove(me, "Извините, за эту голову награды, похоже, нет.");
    DestroyItem(item);
    return;
  else
    PrintTextAbove(me, "Вы принесли голову " + bounty[1] + " . Этот изверг повинен в " + bounty[3] + " убийствах.");
    PrintTextAbove(me, "Лорд Бритиш предлагает награду в " + bounty[2] + " золотых монет, которые я положу в ваш банковский ящик.");
    var gold := Cint(bounty[2]);
    var bank := CP_GetStorageContainerForMobile( who, CP_BANK_AREA, CP_CREATE );
    while(gold >= 60000)
      gold := gold - 60000;
      CreateItemInContainer(bank, 0xeed, 60000);
    endwhile
    CreateItemInContainer(bank, 0xeed, gold);
    DestroyItem(item);
  endif
endprogram