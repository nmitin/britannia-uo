use uo;
use os;
use cfgfile;

include ":keys:key";
include ":traps:traps";

program useContainer( mobile, container )

	var item_cfg := ReadConfigFile( ":*:itemdesc" );
	item_cfg := item_cfg[container.graphic];
 
        var house_ref := container.multi;
        if( !house_ref.CanAccess( mobile ))
		SendSysMessage( mobile, "Вы не можете открыть этот защищённый сундук." );
		return 0;
	elseif( mobile.cmdlevel >= 3 )
		SendSysMessage( mobile, "Присутствует командный уровень — контейнер игнорирует замки и ловушки." );
		SendViewContainer( mobile, container );
		return 1;
	elseif( ContainerIsLocked( mobile, container ))
		return 0;
	endif
 
        SendSysMessage( mobile, "Вы открываете защищённый сундук." );
	SendViewContainer( mobile, container );

	if(( item_cfg.OpenGraphic ) && ( item_cfg.CloseGraphic ))
		container.graphic := item_cfg.OpenGraphic;
		Sleep(2);
		container.graphic := item_cfg.CloseGraphic;
	endif

	return 1;
endprogram

function ContainerIsLocked( mobile, container )

	if( !container.locked )
		// Nothing to worry about.
		return 0;
	elseif( KP_HasKeyForLock( mobile, container ))
		SendSysMessage( mobile, "Вы открываете контейнер ключом." );
		return 0;
	else
		PrintTextAbovePrivate( container, "Это заперто.", mobile );
		return 1;
	endif
endfunction
