use uo;

include ":traps:traps";

program RemoveAllTraps(who)

	SendSysMessage( who, "С какого предмета убрать все ловушки?", color := 88);
	var object := Target( who, TGTOPT_NOCHECK_LOS );
	var traplist := GetTrapList(object);
	foreach trap in traplist
		RemoveTrap( object, _trap_iter );
	endforeach
	SendSysMessage( who, "Все ловушки удалены.", color := 66 );

endprogram
