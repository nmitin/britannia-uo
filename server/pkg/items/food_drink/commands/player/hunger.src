/////////////////////////////////////////////////
// Simple .hunger script that hopefully will evolve into
// something more than just how hungry you are
/////////////////////////////////////////////////

// Variables used in this script:
// hunger (This is a number pulled directly off the character
//              types ".hunger".)

use uo;

include ":attributes:attributes";

Program HungerStatus(who)

    var hungerstatus;

// How hungry is the who?
	hungerstatus := CInt( AP_GetVital( who, "Hunger" ));

// And now to display how hungry the player is...
	if (hungerstatus <= 0)
		hungerstatus := 0;
    endif

    case (hungerstatus)
      10 : SendSysMessage(who, "Вы не голодны.", color := 66);
       9 : SendSysMessage(who, "Вы не голодны.", color := 66);
       8 : SendSysMessage(who, "Вы не голодны.", color := 66);
	   7 : SendSysMessage(who, "Ммм... вам стоит что-нибудь съесть.", color := 56);
	   6 : SendSysMessage(who, "Вам скоро стоит перекусить.", color := 56);
	   5 : SendSysMessage(who, "Вы голодны.", color := 44);
	   4 : SendSysMessage(who, "Вы очень голодны.", color := 44);
	   3 : SendSysMessage(who, "Вы так голодны, что кружится голова.", color := 44);
	   2 : SendSysMessage(who, "Ваше тело истощено голодом.", color := 33);
	   1 : SendSysMessage(who, "Вы крайне голодны.", color := 33);
	   0 : SendSysMessage(who, "Вы умираете от голода!!!", color := 33);
    endcase

endprogram
