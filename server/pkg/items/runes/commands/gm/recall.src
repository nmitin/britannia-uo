use uo;
use os;

include "include/objtype";

program textcmd_recall( caster )


	var dest := struct;
	SendSysMessage( caster, "Выберите цель для возврата." );
	var cast_on := Target(caster);
	if (!cast_on)
		SendSysMessage(caster, "Отменено.", 1, 33);
		return;
	endif
	
	if(cast_on == caster)
		dest := GetObjProperty(caster, "RecallDestination");
		if(!dest)
			SendSysMessage(caster, "Вы ещё не отмечали себя.", 1, 33);
			return 0;
		endif
		MoveObjectToLocation( caster, dest.x, dest.y, dest.z, dest.realm, MOVEOBJECT_FORCELOCATION );
		return 1;
	endif
	
	if (cast_on.objtype != UOBJ_RUNE)
		SendSysMessage(caster, "Это можно наложить только на руну возврата!");
		return 0;
	endif

	if (!Accessible(caster, cast_on))
		SendSysMessage(caster, "Вы не можете до этого дотянуться!");
		return 0;
	endif

	dest := cast_on.GetDestination();

	MoveObjectToLocation( caster, dest.x, dest.y, dest.z, dest.realm, MOVEOBJECT_FORCELOCATION );

endprogram