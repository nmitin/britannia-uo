use uo;
use util;

include ":itemutils:itemUtil";
include "include/security";

program textcmd_ownEquip( mobile )

        if( !AuthorizationCode( mobile ))
                SendSysMessage( mobile, "Отменено." );
                return 0;
        endif
        
        SendSysMessage( mobile, "Выберите предмет, чтобы назначить владельца." );
        var targ := Target( mobile );
        if( !targ )
                SendSysMessage( mobile, "Отменено." );
                return 0;
        elseif( !targ.IsA( POLCLASS_EQUIPMENT ))
                SendSysMessage( mobile, "Нужно выбрать носимый предмет." );
                return 0;
        elseif( !useItem_check( mobile, targ ))
		return 0;
        endif
        
        SendSysMessage( mobile, "Выберите нового владельца "+targ.desc+"." );
        var character := Target( mobile );
        if( !character )
                SendSysMessage( mobile, "Отменено." );
                return 0;
        elseif( !character.connected )
                SendSysMessage( mobile, "Нужно выбрать подключённого персонажа." );
                return 0;
        endif
        
        SetObjProperty( targ, "owner", character.serial );
        
        SendSysMessage( mobile, "Теперь только "+character.name+" может носить "+targ.desc+"." );
        
	return 1;
endprogram
