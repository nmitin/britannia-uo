use uo;

include "include/security";

program textcmd_Equip( speaker )

        if( !AuthorizationCode( speaker ))
                SendSysMessage( speaker, "Отменено.", color := 33 );
                return 0;
        endif

	SendSysMessage( speaker, "Что надеть?", color := 88 );
	var what := TargetCoordinates( speaker );
	if( !what )
		return 0;
	endif

	SendSysMessage( speaker, "На кого надеть "+what.Desc+"?", color := 88 );
	var who := Target( speaker, TGTOPT_NOCHECK_LOS );
	if( !who )
		return 0;
        elseif( !who.IsA( POLCLASS_MOBILE ))
                SendSysMessage( speaker, "Нужно выбрать игрока или NPC.", color := 33 );
                return 0;
	endif

	var res := EquipItem( who, what.item );
	if( res )
		SendSysMessage( speaker, "Готово!", color := 66 );
	else
		SendSysMessage( speaker, "Не удалось надеть предмет: "+res.errortext, color := 33 );
		return 0;
	endif

	return 1;
endprogram
