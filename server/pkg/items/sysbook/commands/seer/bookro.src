use uo;
use os;

/////////////////////////////////////////////////////
// bookro
//
// This command makes a book read only.
//
/////////////////////////////////////////////////////

program bookro(who)

	while(1)
		SendSysMessage(who, "Укажите книгу, которую хотите сделать только для чтения:", color := 88);
		SendSysMessage(who, "Нажмите <ESC> для отмены.", color := 88);
		var trg := Target(who, TGTOPT_NOCHECK_LOS);
		if(!trg)
			SendSysMessage(who, "Отменено");
			return;
		endif
		SetObjProperty(trg, "NoWrite", 1);
	endwhile
endprogram