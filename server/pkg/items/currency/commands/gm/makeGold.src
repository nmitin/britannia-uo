use uo;
use polsys;

program makegold(mobile, amount)

	if(!amount)
		SendSysMessage(mobile, "Использование: .makegold [количество]");
		return;
	endif

	amount := CInt(amount);

	SendSysMessage(mobile, "Укажите контейнер для золота");
	var cont := Target(mobile);

	if(!cont)
		SendSysMessage(mobile, "Отменено");
		return;
	endif

	if(!cont.IsContainer())
		SendSysMessage(mobile, "Это не контейнер");
		return;
	endif

	var orgamount := amount;
	var created := 0;
	var stacks := 0;
	while(amount > 60000)
		if(CreateItemInContainer(cont, "GoldCoin", 60000))
			amount := amount - 60000;
			created := created + 60000;
			stacks := stacks + 1;
		else
			SendSysMessage(mobile, "Контейнер полон!");
			SendSysMessage(mobile, "Создано "+CStr(created)+", осталось: "+CStr(orgamount-created));
			return;
		endif
	endwhile

	if(amount > 0)
		if(CreateItemInContainer(cont, "GoldCoin", amount))
			created := created + amount;
		else
			SendSysMessage(mobile, "Контейнер полон!");
			SendSysMessage(mobile, "Создано "+CStr(created)+", осталось: "+CStr(orgamount-created));
		endif
	endif

	SendSysMessage(mobile, "Готово. Создано "+CStr(stacks)+" стопок");

endprogram