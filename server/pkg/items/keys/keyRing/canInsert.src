use uo;

program OnInsert( mobile, keyring, movetype, insert_type, adding_item, existing_stack, amt_to_add )

	amt_to_add := amt_to_add;
	existing_stack := existing_stack;
	insert_type := insert_type;
	movetype := movetype;

	if( !adding_item.IsKey() )
		SendSysMessage( mobile, "На связку можно вешать только ключи.", 0x3, 0x22 );
		return 0;
	elseif( EnumerateItemsInContainer( keyring ).Size() >= keyring.MaxItems() )
		SendSysMessage( mobile, "Связка заполнена.", 0x3, 0x22 );
		return 0;
	endif

	SendSysMessage( mobile, "Вы повесили ключ на связку." );

	return 1;
endprogram
