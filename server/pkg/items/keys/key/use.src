use uo;

include ":keys:key";
include ":gumps:requestGump";
include "include/string";
include ":itemutils:itemUtil";

program UseKey( who, key )

	if( !useItem_check( who, key, ITEM_INCONTAINER ))
		return 0;
	endif

	SendSysMessage( who, "На что вы хотите это применить?" );
	var targ := Target( who );
        if( !targ )
                SendSysMessage( who, "Отменено." );
                return 0;
	elseif( targ == key )
		RenameKey( who, key );
		return 1;
	elseif( targ.IsKey() )
		CopyKey( who, key, targ );
		return 1;
	elseif( !KP_IsLockable( targ ))
		SendSysMessage( who, "Это нельзя запереть." );
		return 0;
	endif

	if( key.KeyMatchesLock( targ ))
		KP_ToggleLock( targ, who );
	else
		SendSysMessage( who, "Этот ключ не подходит к замку." );
	endif

	return 1;
endprogram

function RenameKey( who, key )

	var new_name := RequestGump( who, "Enter a name for this key", "Maximum length is 20 characters.", key.desc, CANCEL_BTN_ON );
	var name_len := Len( new_name );

	if( !new_name )
		SendSysMessage( who, "Отменено." );
		return 0;
	elseif( name_len > 20 )
		SendSysMessage( who, "Имя слишком длинное." );
		return 0;
	elseif( name_len < 1 )
		SendSysMessage( who, "Имя слишком короткое." );
		return 0;
	elseif( new_name )
		SetName( key, new_name );
		return 1;
	endif
endfunction

function CopyKey( who, key, targ )

	var key_id := key.GetLockId();
	if( !key_id )
		SendSysMessage( who, "Нельзя скопировать чистый ключ." );
		return 0;
	elseif( targ.GetLockId() )
		SendSysMessage( who, "Целевой ключ не чистый." );
		return 0;
	endif

	targ.SetLockId( key_id );
	SendSysMessage( who, "Копирование ключей завершено." );

	return 1;
endfunction
