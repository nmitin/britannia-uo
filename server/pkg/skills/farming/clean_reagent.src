use uo;
use cfgfile;
use util;
use os;

include "include/client";


program clean(who, reg)

	if ((RandomInt(1000) + 1) < 950)
		var cfg := ReadConfigFile("itemdesc");
		var what := cfg[reg.objtype].product;
		var howmuch := cfg[reg.objtype].produceamount;
		CreateItemInBackpack(who, what, howmuch);
		DestroyItem(reg);
		SendSysMessage(who, "Вы успешно отделили реагент");
	else
		DestroyItem(reg);
		SendSysMessage(who, "Растение рассыпается, пока вы его чистите.");
	endif
endprogram