// $Id: makeBolt.src 1266 2008-09-04 00:23:03Z AustinHeilman $

use uo;
use cfgfile;
use util;

include ":attributes:attributes";
include ":crafting:toolWear";

CONST UOBJ_LOOM_START		:= 0x105f;
CONST UOBJ_LOOM_END			:= 0x1066;
CONST UOBJ_BOLT					:= 0xf95;

var item_config := ReadConfigFile(":*:itemdesc");

program make_Bolt(who, thread)
	if ( !ReserveItem(thread) )
		SendSysMessage(who, "Это уже используется.");
		return 0;
	elseif ( (!thread.movable) || !ReserveItem(thread) )
		SendSysMessage(who, "Вы не можете это использовать");
		return 0;
	elseif ( !(thread in EnumerateItemsInContainer(who.backpack)) )
		SendSysMessage(who, "Этого предмета нет в рюкзаке.");
		return 0;
	endif

	EraseObjProperty(who, "#IsMeditating");
	EraseObjProperty(who, "#HealTimer");
	
	SendSysMessage(who, "Выберите ткацкий станок.");

	var tool := Target(who);
	if ( !tool )
		SendSysMessage(who, "Отменено.");
		return;
	endif

	if ( (tool.objtype < UOBJ_LOOM_START) || (tool.objtype > UOBJ_LOOM_END))
		SendSysMessage(who, "Это можно использовать только на ткацком станке.");
		return;
	else
		makeBolt(who, thread);
	endif
endprogram

function makeBolt(who, item)
	if ( item.amount <= 0 )
		SendSysMessage(who, "У вас нет ниток!");
		return;
	endif

	if ( ( item.amount > 0 ) && ( item.amount <= 4 ) )
		SendSysMessage(who, "Недостаточно ниток для рулона.");
		return;
	endif

	if ( SubtractAmount(item, 5) )
		var bolt := CreateItemInBackpack(who, UOBJ_BOLT, 1);
		if ( !bolt )
			SendSysMessage(who, "Не удалось создать рулон ткани.");
		else
			SendSysMessage(who, "Вы работаете за станком и создаёте рулоны.");
		endif
	endif
endfunction
