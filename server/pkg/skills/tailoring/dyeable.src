use os;
use uo;
use cfgfile;

include "include/canAccess";

var cfg  := ReadConfigFile( ":*:itemdesc" );

program dyeable(who, dyetub)
  if(who.cmdlevel >= 2)
    SendSysMessage (who, "Администратор использует чан с краской. Выберите предмет:", color := 88);
    var item := Target(who);
    if(!item)
      SendSysMessage(who, "Отменено");
      return;
    endif
    item.color := dyetub.color;
    PlaySoundEffect(who, 0x23f);
    return;
  endif
// this next piece of code kept players from using illegal colours
/*  if(dyetub.color > 1001)
    dyetub.color := 38;
  endif */
  if(!can_access(who, dyetub))
    return;
  endif
  if(!ReserveItem(dyetub))
	return;
  endif
  SendSysMessage(who, "Выберите предмет для покраски");
  var item := Target(who);
  if(!item)
    SendSysMessage(who, "Отменено");
    return;
  endif
  if(!can_access(who, item))
    return;
  endif
  if(!ReserveItem(item))
    SendSysMessage(who, "Этот предмет уже используется!");
    return;
  elseif(!Accessible(who, item))
    SendSysMessage(who, "Вы не можете до этого дотянуться!");
    return;
  endif
  if (item.objtype == 0xfab) // a dye tub
      SendSysMessage(who, "Нельзя покрасить чан с краской. Используйте красители, чтобы смешать цвет.", color := 33);
      return;
  endif
  var element  := FindConfigElem(cfg,  item.objtype);
  var dyeable  := GetConfigInt(element, "dyeable");
    if(GetConfigInt(element, "ColorFast"))
	dyeable := 0;
    endif
  if(dyeable == 1)
      item.color := dyetub.color;
      PlaySoundEffect(who, 0x23f);
  else
    SendSysMessage( who, "Этот предмет не впитывает краску.", color := 33);
    return;
  endif
endprogram