use uo;
use os;

include "include/canAccess";

program use_dyes(who, dyes)
  if(!ReserveItem(dyes))
    SendSysMessage(who, "Эти красители уже используются.");
    return;
  endif
  if(!can_access(who, dyes))
    return;
  endif
  SendSysMessage(who, "Выберите чан с краской для использования красителей.");
  var dyetub := Target(who, TGTOPT_CHECK_LOS);
  if(!ReserveItem(dyetub))
     SendSysMessage(who, "Это уже используется.");
     return;
  endif
  if(!can_access(who, dyetub))
    return;
  endif
  if(!Accessible(who, dyetub))
    SendSysMessage(who, "Вы не можете до этого дотянуться!");
    return;
  endif
  if((dyetub.objtype != 0x2B00F) && (dyetub.objtype != 0x0fab))
    SendSysMessage(who, "Это не чан с краской!");
    return;
  endif
  var color := SelectColor(who, dyetub);
  if( color > 1001 )
//    var account := who.acct;
    SendSysMessage( who, "Здесь не терпят использующих ошибки." );
    who.frozen := 1;
    SendSysMessage(who, "Вы забанены за использование ошибок.");
    SetObjProperty(who,"justbanned", 1);
    var characters := EnumerateOnlineCharacters();
    foreach chr in characters
      if(chr.cmdlevel > 1)
        SendSysMessage(chr, "аккаунт " + who.acctname + " забанен за использование красителей.");
      endif
    endforeach
    sleep(5);
    DisconnectClient(who);
    start_script(":tailoring:dyeBan", who);
  else
    dyetub.color := color;
  endif
endprogram