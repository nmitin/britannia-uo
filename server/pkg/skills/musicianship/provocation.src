use uo;
use os;
use util;
use cfgfile;

include "include/client";
include "include/objtype";
include "include/bard";
include "include/eventID";

program bard_provoke(who)
  EraseObjProperty(who, "IsMeditating");
    if(Cint(GetObjProperty(who, "LastProvoke")) > ReadGameClock())
    SendSysMessage(who, "Подождите немного перед следующей игрой.");
    return;
  endif
  SetObjProperty(who, "LastProvoke", Cint(ReadGameClock() + 2));
  var instrument := findinstrument(who);
  if(!instrument)
    SendSysMessage(who, "У вас нет инструмента!");
    return;
  endif
  if(!ReserveItem(instrument))
    return;
  endif
  SendSysMessage(who, "Выберите существо для провокации.");
  var thetarg := Target(who, TGTOPT_HARMFUL);
  if((!thetarg) || (!thetarg.npctemplate))
    SendSysMessage(who, "Выбор цели отменён.");
    return;
  endif
  if(Distance(who, thetarg) > 10)
    SendSysMessage(who, "Цель слишком далеко.");
    return;
  endif
  var configfile := ReadConfigFile("::npcdesc");
  var theobj:= thetarg.npctemplate;
  var elem := FindConfigElem(configfile, theobj);
  var difficulty;
  if(elem)
	difficulty := elem.provoke;
  else
    SendSysMessage(who, "Это нельзя спровоцировать!");
    return;
  endif
  if(!difficulty)
	difficulty := 100;
  endif
  var ev := Struct;
  ev.+ type;
  ev.+ source;
  if(difficulty < 1)
	difficulty := 0;
  elseif(difficulty > 100)
	difficulty := 110;
  endif
  if(play(who, difficulty, instrument, PROVOCATION))
	SendSysMessage(who, "Выберите цель, на которую направить провокацию.");
	var newtarg := Target(who, (TGTOPT_NOCHECK_LOS + TGTOPT_HARMFUL) );
        if(newtarg == thetarg)
          SendSysMessage(who, "Нельзя спровоцировать существо на само себя!");
          return;
        endif
	if((Distance(thetarg, newtarg) > 10) || (Distance(who, newtarg) > 10))
	  SendSysMessage(who, "Цель слишком далеко.");
	  return;
	endif
	SendSysMessage(who, "Вы провоцируете " + thetarg.name + " атаковать " + newtarg.name + "!");
	ev.source := newtarg;
	if(newtarg.warmode)
	  ev.type := EVID_PEACEMADE;
	  SendEvent(thetarg, ev);
	  SendEvent(newtarg, ev);
	  sleep(1);
	endif
	ev.type := EVID_DAMAGED;
	SendEvent(thetarg, ev);
	ev.source := thetarg;
	SendEvent(newtarg, ev);
  else
	ev.source := who;
	if(thetarg.warmode)
	  ev.type := EVID_PEACEMADE;
	  SendEvent(thetarg, ev);
	  sleep(1);
	endif
	ev.type := EVID_DAMAGED;
	PrintTextAbovePrivate(thetarg, "Вы злите " + thetarg.name + "!", who);
    SendEvent(thetarg, ev);
  endif
endprogram