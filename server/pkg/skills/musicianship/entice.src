use uo;
use os;
use util;

include "include/client";
include "include/objtype";
include "include/bard";
include "include/eventID";

program enticement(who)
  var subject := Target(who, TGTOPT_NOCHECK_LOS );
  if ((!subject) || (!subject.npctemplate))
    SendSysMessage(who, "Отменено.");
    return;
  endif
  if(subject.script == ":musicianship:enticedAI")
    SendSysMessage(who, "Похоже, уже под действием эффекта.");
    return;
  endif
  var cfg := ReadConfigFile("::npcdesc");
  var diff := Cint(cfg[subject.npctemplate]."provoke");
  if(!diff)
    SendSysMessage(who, "Вы не можете его соблазнить!");
    return;
  endif
  var instrument := findinstrument(who);
  if(!instrument)
    SendSysMessage(who, "У вас нет инструмента!");
    return;
  endif
  var success := play(who, diff, instrument, DISCORDANCE);
  if(success)
    var ev := struct;
    ev.+type := EVID_ALL_FOLLOW_CMD;
    ev.+source := who;
    ev.+x := who.x;
    ev.+y := who.y;
    SetObjProperty( subject, "oldai", subject.script);
    subject.script := ":musicianship:enticedAI";
    RestartScript(subject);
    SendEvent(subject, ev);
    PrintTextAbove(subject, subject.name+" словно заворожён музыкой");
  else
    PrintTextAbovePrivate(subject, "Похоже, ваша музыка не действует.", who);
    if ((Randomint(10)+1)<= 3)
      var ev := {};
        ev.+source := who;
        ev.+type := EVID_PEACEMADE;
      SendEvent(subject,ev);
      ev.type := EVID_DAMAGED;
      SendEvent(subject, ev);
      PrintTextAbove(subject, subject.name+" раздражён музыкой "+who.name);
    endif
  endif
endprogram

