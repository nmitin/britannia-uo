use uo;
use cliloc;

include ":attributes:attributes";
include ":traps:traps";
include ":itemutils:itemUtil";

program skill_RemoveTrap( mobile )

        SendSysMessage( mobile, "Выберите контейнер с ловушкой для обезвреживания." );
        var targ := Target( mobile ),
            traps := GetTrapList( targ );

        if( !targ )
                SendSysMessage( mobile, "Отменено." );
                return 0;
        elseif( !useItem_check( mobile, targ, DEFAULT_ITEM, 1 ))
		return 0;
        elseif( !targ.IsA( POLCLASS_CONTAINER ))
                SendSysMessage( mobile, "Нужно выбрать контейнер с ловушкой!" );
                return 0;
        elseif( Len( traps ) < 1 )
                SendSysMessageCL( mobile, 502373, color := 56 ); // That doesn't appear to be trapped
                return 0;
        elseif( !IsTrapRevealed( targ ))
                SendSysMessage( mobile, "Сначала нужно обнаружить ловушку!" );
                return 0;
        endif

        if( SkillCheck( mobile, REMOVE_TRAP, -1 ) > 0 )
               SendSysMessage( mobile, "Вы успешно обезвредили "+targ.desc+".", color := 66 );
        else
               SendSysMessage( mobile, "Вы не смогли обезвредить "+targ.desc+".", color := 33 );
               RunTraps( targ, mobile );
        endif

        RemoveTrap( targ );

	return 1;
endprogram
