use uo;
use cfgfile;
use os;
use util;

include ":coords:coords";
include "include/canAccess";

program use_message( who, message )
  EraseObjProperty(who, "IsMeditating");
  EraseObjProperty(who, "HealTimer");
  if(!can_access(who, message))
    return;
  endif
  if(message.movable == 0)
    SendSysMessage(who, "Вы не можете это использовать.");
    return;
  endif
  var tox := GetObjProperty(message, "tileX");
  var toy := GetObjProperty(message, "tileY");
  var msgindex := GetObjProperty(message, "msgnum");
  if( tox.errortext || toy.errortext)
	syslog("bad message "+tox+" "+toy);
	DestroyItem(message);
	SendSysMessage(who, "Послание искажено так, что вы не можете его прочесть!");
	return;
  endif
  var layout := array(  "page 0",
    	                    "resizepic 0 0 3500 300 200",
        	                "button 110 140 1148 1149 1 0 1",
            	            "text 20 30 0 0",
                	        "text 20 50 0 1",
                    	    "text 20 70 0 2");
  var data := array();
  var coords := ToSextant(tox, toy);
  case (msgindex)
	0: 	data[1] := "Помогите, наш корабль тонет! Мы";
		data[2] := "на координатах " + coords + "! Пожалуйста,";
		data[3] := "поторопитесь, мы быстро уходим под воду!";
	1: 	data[1] := "На нас напал гигантский";
		data[2] := "морской змей! Мы на координатах";
		data[3] :=  + coords + "! Пожалуйста, помогите нам!";
	2: 	data[1] := "Свирепый зверь пробил наш корабль.";
		data[2] := "Мы находимся в " + coords + "!";
		data[3] := "Мы будем держаться сколько сможем.";
	3: 	data[1] := "Мы попали в страшный шторм";
		data[2] := "на координатах " + coords + "!";
		data[3] := "Корабль скоро может перевернуться, торопитесь!";
  endcase
  SendDialogGump( who, layout, data );
endprogram