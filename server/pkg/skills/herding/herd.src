use os;
use uo;
use cfgfile;

include "include/client";
include "include/eventID";
include ":virtue:noto";
include ":attributes:attributes";

program herd(who)
        SendSysMessage(who, "Кого вы хотите пасти?");
        var npc := Target(who);
        if (!npc)
                SendSysMessage(who, "Отменено!");
                return;
        endif
/*      if(who.cmdlevel >= 2)
                var location := TargetCoordinates(who);
                if(!CheckLosAt(npc, location.x, location.y, location.z))
                        SendSysMessage(who, npc.name + " can't see that location!");
                        return;
                endif
                var holder := {};
                holder.append(location.x);
                holder.append(location.y);
                var ev := struct;
                ev.+type := EVID_HERDING;
                ev.+data := holder;
                SendEvent(npc, ev);
                return;
        endif */
        if(!CheckLineOfSight(who, npc))
                SendSysMessage(who, "Вы этого не видите!");
        endif
        var cfg := ReadConfigFile("::npcdesc");
        var herdskill := CInt( cfg[npc.npctemplate]."herdskill" * 3 );
        var chk := 0;
        case(npc.script)
                "tamed":    chk := 1;
                "worker":   chk := 1;
                "employed": chk := 1;
        endcase
        if((chk == 1) or (!herdskill))
                SendSysMessage(who, "Это нельзя пасти!");
                return;
        endif
		var pts := CInt(GetAttribute(who, HERDING) / 10) + 15;
		if(pts > 35)
			pts := 35;
		endif
		if(SkillCheck( who,HERDING, herdskill, pts/3 ) > 0)

                SendSysMessage(who, "Куда вы хотите переместить "+ npc.name +" to?");
                var location := TargetCoordinates(who);
                if (!CheckLosAt(npc, location.x, location.y, location.z))
                        SendSysMessage(who, npc.name + " не видит это место!");
                        return;
                endif
                var holder := {};
                holder.append(location.x);
                holder.append(location.y);
                var ev := struct;
                ev.+type := EVID_HERDING;
                ev.+data := holder;
                SendEvent(npc, ev);
				VS_AdjustVirtue(who, "humility", 1, 50);
        else
                SendSysMessage(who, "Похоже, не удаётся убедить " + npc.name + " идти");
                return;
        endif
endprogram
