use uo;
use os;

include ":attributes:attributes";

program command_AttribConvert( who, input )

	if( !input )
		SendSysMessage( who, "Ошибка — не передан skillID или имя атрибута." );
		return 0;
	elseif( Len( input ) <= 2 )
		SendSysMessage( who, "SkillID ["+input+" ] указывает на атрибут "+AP_SkillIdToAttributeName( input ));
	else
		SendSysMessage( who, "Атрибут ["+input+" ] указывает на skillID "+AP_AttributeNameToSkillId( input ));
	endif
endprogram
