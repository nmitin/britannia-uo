use uo;
use os;

include ":attributes:attributes";

program command_TitleTest( mobile, input )
	var title := AP_GetSkillTitle( input );
	if( title )
		SendSysMessage( mobile, "Титул для атрибута «"+input+"' is '"+title+"'" );
		return 1;
	else
		title := AP_GetLevelTitle( CDbl( input ));
		SendSysMessage( mobile, "Титул для уровня навыка «"+input+"» будет «"+title+"'" );
		return 1;
	endif
endprogram
