use uo;
use os;

include "include/security";

program textcmd_openGuild( mobile )

        if( !AuthorizationCode( mobile ))
                SendSysMessage( mobile, "Отменено." );
                return 0;
        endif

        SendSysMessage( mobile, "Выберите игрока, чтобы посмотреть гильдию." );
        var targ := Target( mobile, TGTOPT_NOCHECK_LOS );
        if( !targ )
                SendSysMessage( mobile, "Отменено." );
                return 0;
        elseif( !targ.IsA( POLCLASS_MOBILE ) || targ.IsA( POLCLASS_NPC ))
                SendSysMessage( mobile, "Нужно выбрать игрока." );
                return 0;
        elseif( !targ.guildid )
                SendSysMessage( mobile, "Этот игрок не состоит ни в одной гильдии." );
                return 0;
        endif

        var start := Start_Script( ":guilds:guildMenu", {targ, mobile} );
        if( start.errortext )
                SendSysMessage( mobile, "Ошибка запуска <:guilds:guildMenu> из команды viewGuild -->"+start.errortext );
        endif

        return 1;
endprogram
