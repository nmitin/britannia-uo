use uo;
use os;

//include "../pkg/world/weather/weather";

program textcmd_moveitem( who )
    SendSysMessage( who, "Выберите NPC для перемещения." );
    var what := Target( who );
    if (what)
            SendSysMessage( who, "Теперь укажите место на земле." );
            var where := TargetCoordinates( who );
            if (where)
                var result := MoveObjectToLocation( what, where.x, where.y, where.z, who.realm, MOVEOBJECT_FORCELOCATION );
                if (result)
                    PrintTextAbovePrivate( what, "Готово!", who );
                else
                    SendSysMessage( who, "Не удалось переместить NPC: " + result.errortext, color := 33 );
                endif
            endif
    endif
//    CheckWeather ( what );
endprogram
