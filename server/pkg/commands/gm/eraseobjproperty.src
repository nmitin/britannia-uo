use uo;

program textcmd_eraseobjproperty( who, propname )
    print( "Property Name: " + propname );

    var tgt := Target( who );
    if (tgt)
        var res := EraseObjProperty( tgt, propname );
        if (res != error)
            SendSysMessage( who, "Свойство " + propname + " стёрто." );
        else
            SendSysMessage( who, "Ошибка стирания свойства: " + res.errortext );
        endif
    endif
endprogram