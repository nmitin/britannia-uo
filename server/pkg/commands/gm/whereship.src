use boat;
use uo;


program textcmd_where( who )
    SendSysMessage( who, "Укажите ключ от корабля" );

    var tgt := Target( who );
    if (tgt)
        var shipserial := GetObjProperty( tgt, "shipserial" );
        if (shipserial)
            var ship := SystemFindBoatBySerial( shipserial );
            if (ship)
                SendSysMessage( who, "Корабль находится в ("+ship.x+","+ship.y+" ) в мире " + ship.realm + "." );
            else
                SendSysMessage( who, "Похоже, такого корабля нет." );
            endif
        else
            SendSysMessage( who, "Это не ключ от построенного корабля." );
        endif
      
    endif
endprogram