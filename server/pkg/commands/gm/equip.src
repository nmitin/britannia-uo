use uo;

program textcmd_equip( speaker )
    SendSysMessage( speaker, "Что надеть?" );

    var what := Target( speaker );
    if (!what)
        return;
    endif

    SendSysMessage( speaker, "На кого надеть " + what.desc + "?" );
    var who := Target( speaker );
    if (!who)
        return;
    endif

    var res := EquipItem( who, what );
    if (res)
        SendSysMessage( speaker, "Готово!" );
    else
        SendSysMessage( speaker, "Не удалось надеть предмет: " + res.errortext );
    endif
endprogram