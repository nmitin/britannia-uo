use uo;

program textcmd_destroy( who )
	SendSysMessage( who, "Укажите, что уничтожить.", 1, 88 );
	SendSysMessage( who, "Нажмите <ESC> для выхода.", 1, 88 );
	while(1)
		var tgt := Target( who, TGTOPT_NOCHECK_LOS );
		if(!tgt)
			SendSysMessage(who, "Отменено.", 1, 33);
			return 0;
		endif
		if(GetObjProperty(tgt, "DecorateFacetsStatic"))
			SendSysMessage(who, "Этот предмет нельзя уничтожить.", 1, 33);
			SendSysMessage(who, "Уничтожить может только разработчик ", 1, 33);
			continue;
		endif
		if(!tgt.isA(POLCLASS_NPC) || !tgt.client)
			DestroyItem( tgt);
		else
		SendSysMessage( who, "Уничтожать можно только предметы", 1, 33 );
		endif
	endwhile
endprogram