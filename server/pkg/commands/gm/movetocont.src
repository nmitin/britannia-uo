use uo;

program textcmd_moveitem( who )
    SendSysMessage( who, "Выберите предмет для перемещения." );
    var what := TargetCoordinates( who );
    if (what)
        if (what.item)
            SendSysMessage( who, "Теперь выберите контейнер." );
            var cont := TargetCoordinates( who );
            if (cont.item)
                    // note that the x/y from TargetCoordinates is the position
                    // of the container in the world.  We'll let MoveItemToContainer
                    // decide a random location within the container
                    // (by leaving parameters 2 and 3 default)
                var result := MoveItemToContainer( what.item, cont.item );
                if (result)
                    PrintTextAbovePrivate( what.item, "Готово!", who );
                else
                    SendSysMessage( who, "Не удалось переместить предмет: " + result.errortext );
                endif
            endif
        else
            SendSysMessage( who, "Команда работает только с предметами." );
        endif
    endif
endprogram