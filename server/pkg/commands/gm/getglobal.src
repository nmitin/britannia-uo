use uo;

program textcmd_getglobal( who, propname )
    print( "Property Name: " + propname );

    var res := GetGlobalProperty( propname );
    if (res != error)
        SendSysMessage( who, "Свойство " + propname + ": " + res );
    else
        SendSysMessage( who, "Ошибка получения свойства: " + res.errortext );
    endif
endprogram