use uo;

program textcmd_setmovable( who, movable )
    movable := CInt(movable);
    if (movable)
        SendSysMessage( who, "Укажите предмет, чтобы сделать перемещаемым" );
    else
        SendSysMessage( who, "Укажите предмет, чтобы сделать неперемещаемым" );
    endif

    var obj := Target( who );
    if (obj)
        obj.movable := movable;
    endif
endprogram