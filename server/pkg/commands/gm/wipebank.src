use uo;

include ":containers:storageAreas";

program textcmd_wipebank(who)

    SendSysMessage( who, "Чей банк очистить?", 0x3, 0x42 );
    var whom := Target( who );
    if( !whom )
        SendSysmessage( who, "Действие отменено.", 0x3, 0x32 );
        return 0;
    endif

    var bank_box := CP_GetStorageContainerForMobile( whom, CP_BANK_AREA, CP_NOCREATE );

    bank_box.CloseContainer( whom );

    if( CP_RemoveStorageAreaContainer( "Bankbox of "+whom.serial, CP_BANK_AREA ) )
        SendSysMessage( who, who.name+" : банковский ящик удалён.", 0x3, 0x42 );
    endif

    return 1;
endprogram