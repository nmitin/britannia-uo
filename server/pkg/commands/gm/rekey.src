use uo;

include ":keys:key";

program rekey( who )

    SendSysMessage( who, "Укажите ДВЕРЬ для смены замка." );
    var lockeditem := Target( who, "" );

    if(! lockeditem)
       SendSysMessage( who, "Отменено." );
       return;
    endif

    if (lockeditem.isa(POLCLASS_DOOR) or lockeditem.isa(POLCLASS_CONTAINER))

        var LockID := AllocateLockID();

        SetObjProperty( lockeditem, "LockID", LockID );

        var key := CreateItemInBackpack( who, 0x100f, 1 );
		key.SetLockId(LockID);
//        SetObjProperty( key, "LockID", LockID );

        SendSysMessage( who, "Создан ключ в рюкзаке.", color := 66 );
    else
        SendSysMessage( who, "Это нельзя запереть.", color := 33 );
    endif

endprogram
