use uo;
use os;

include "include/client";


program color(who, textline)
	if (!textline)
		SendSysMessage (who, "Использование: color [число] или none (без кавычек)", color := 88);
		return;
	endif

	var item := target(who);

	if (textline == "none")
		item.color := 0;
		return;
	endif

	item.color := CInt(textline);

	return;


endprogram
