use uo;

include "include/client";

program Shave( who, text )

        if ((text == "") or (!text))
          SendSysMessage( who, "Укажите, что побрить (Head, Face)." );
          return;
        endif

   if ( text == "face" )
   SendSysMessage( who, "Чьё лицо побрить?" );
   var guy := Target( who, "" );

   var hair := GetEquipmentByLayer( guy, LAYER_BEARD );

   DestroyItem( hair );

   elseif ( text == "head" )
   SendSysMessage( who, "Чью голову побрить?" );
   var baldy := Target( who, "" );

   var hair := GetEquipmentByLayer( baldy, LAYER_HAIR );

   DestroyItem( hair );

   endif

endprogram
