use uo;


program textcmd_eraseglobal( who, propertyname )
    print( "Property Name: " + propertyname );

    var res := EraseGlobalProperty( propertyname );
    if (res != error)
        SendSysMessage( who, "Свойство " + propertyname + " стёрто." );
    else
        SendSysMessage( who, "Ошибка стирания свойства: " + res.errortext );
    endif
endprogram