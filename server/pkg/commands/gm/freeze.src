use uo;

program hideme( gm )
    SendSysMessage( gm, "Кого заморозить?" );
    var res := TargetCoordinates( gm );
    if (res.mobile)
        res.mobile.frozen := 1;
	SetObjProperty(res.mobile,"frozen",1);
        PrintTextAbovePrivate( res.mobile, res.mobile.name + " заморожен", gm );
    else
        SendSysMessage( gm, "Отменено" );
    endif
endprogram