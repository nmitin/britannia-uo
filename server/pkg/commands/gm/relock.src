use uo;

include ":keys:key";

program relock( who )

    SendSysMessage( who, "Сначала укажите КЛЮЧ." );
    var key := Target( who, "" );
    if(! key)
       SendSysMessage( who, "Отменено." );
       return;
    endif

    SendSysMessage( who, "Теперь укажите дверь или контейнер." );
    var lockeditem := Target( who, "" );

    if(! lockeditem)
       SendSysMessage( who, "Отменено." );
       return;
    endif

    var LockID := key.GetLockId();

    SetObjProperty( lockeditem, "LockID", LockID );

    SendSysMessage( who, "Предмет изменён под этот ключ." );

endprogram