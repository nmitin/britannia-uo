use uo;

program destroy_multi( who )
    var multi;

    if (who.multi)
        multi := who.multi;
    else
        multi := Target( who, TGTOPT_NOCHECK_LOS );
    endif

    var res := DestroyMulti( multi );
    if (!res)
        SendSysMessage( who, "Не удалось уничтожить мульти: " + res.errortext );
    endif
endprogram