use uo;
use os;

program mylight (who, text)

        SendSysMessage(who,"Выберите цель");
        var targ := target( who, TGTOPT_NOCHECK_LOS );

	if (text && text == "off")
		targ.setlightlevel (0, 0);
		return;
	endif

	if (text && text == "dark")
		targ.setlightlevel (20, 3800);
		return;
	endif

	if (text && text["level"])
		var parms := SplitWords(text);
		if (len(parms) != 3)
			SendSysMessage(who, "Неверная настройка. Правильное использование:");
			SendSysMessage(who, "уровень света [day или night] [0–30]");
			SendSysMessage(who, "0 — обычный день, 20 — обычная ночь.");
			return;
		endif

		if (parms [2] != "day" && parms[2] != "night")
			SendSysMessage(who, "Неверная настройка. Правильное использование:");
			SendSysMessage(who, "уровень света [day или night] [0–30]");
			SendSysMessage(who, "0 — обычный день, 20 — обычная ночь.");
			return;
		endif

		var lightlevel := CInt(parms[3]);
		if (!lightlevel && lightlevel != 0)
			SendSysMessage(who, "Неверная настройка. Правильное использование:");
			SendSysMessage(who, "уровень света [day или night] [0–30]");
			SendSysMessage(who, "0 — обычный день, 20 — обычная ночь.");
			return;
		endif

		if (lightlevel < 0 || lightlevel > 30)
			SendSysMessage(who, "Неверная настройка. Правильное использование:");
			SendSysMessage(who, "уровень света [day или night] [0–30]");
			SendSysMessage(who, "0 — обычный день, 20 — обычная ночь.");
			return;
		endif

		if (parms[2] == "day")
			set_critical(1);
			SetGlobalProperty("daylight_level", lightlevel);
			set_critical(0);
		else
			set_critical(1);
			SetGlobalProperty("nighttime_level", lightlevel);
			set_critical(0);
		endif

		SendSysMessage(who, "Готово!");
		return;
	endif
 
        if(Cint(text) > 30)
                text := 30;
        endif
 
        targ.setlightlevel (Cint(text), 3600);
        SendSysMessage(who, targ.name + " : уровень света теперь: " + Cint(text));
 
 
endprogram;
