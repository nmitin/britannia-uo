
use uo;

program change_cmdlevel( who, level )
  SendSysMessage( who, "Чей командный уровень изменить?" );
  var player := Target( who, TGTOPT_NOCHECK_LOS );
  if(player.ip)
    var holder := "a";
    case(level)
      "test":   holder := 5;
      "admin":  holder := 4;
      "gm":     holder := 3;
      "seer":   holder := 2;
      "coun":   holder := 1;
      "player": holder := 0;
      default:  SendSysMessage(who, "это недопустимый командный уровень."); 
    endcase
    if(holder == "a")
      return;
    else
      if(holder <= who.cmdlevel)
        player.cmdlevel := holder;
      else
        SendSysMessage(who, "Нельзя выдать уровень выше своего");
      endif
    endif
  else
    SendSysMessage(who, "Это не игрок");
  endif
endprogram
