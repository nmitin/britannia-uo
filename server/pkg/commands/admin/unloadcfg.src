use cfgfile;
use uo;

program textcmd_unloadcfg( who, filename )

	var res := UnloadConfigFile( filename );
	if (res == error)
		SendSysMessage( who, "Ошибка выгрузки конфигурации: " + res.errortext );
	elseif (res < 0)
		SendSysMessage( who, "Эта конфигурация не загружена." );
	else
		SendSysMessage( who, "Конфигурация выгружена.  " + res + " ссылок на конфигурацию существует." );
	endif

endprogram