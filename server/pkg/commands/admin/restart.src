
use uo;

program textcmd_action( who, newscript )
    SendSysMessage( who, "Укажите NPC для перезапуска" );

    var npc := Target( who, TGTOPT_NOCHECK_LOS );
    if (npc)
        if (newscript)
            npc.script := newscript;
        endif
        var res := RestartScript( npc );
        if (!res)
            SendSysMessage( who, "Не удалось перезапустить: " + res.errortext );
        endif
    endif
endprogram