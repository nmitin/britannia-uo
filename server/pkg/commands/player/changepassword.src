use uo;

include "include/client";

program Changepassword(who)

        var acct := who.acct;
	var newpassword := SendTextEntryGump (who, "Please enter your new password",
					TE_CANCEL_ENABLE, TE_STYLE_NORMAL, 16, "16 characters max");
	if (!newpassword)
		sendsysmessage (who, "Отменено.");
		return;
	endif

	var passcheck := SendTextEntryGump (who, "Please re-enter your new password",
					TE_CANCEL_ENABLE, TE_STYLE_NORMAL, 16, "16 characters max");
	if (!passcheck)
		sendsysmessage (who, "Отменено.");
		return;
	endif

	if ( newpassword == passcheck )
		SendSysMessage( who, "Пароль изменён!", FONT_BOLD, MESSAGE_COLOR_GOOD);
		acct.setpassword (newpassword);
		SendSysMessage( who, "Не забудьте его!", FONT_BOLD, MESSAGE_COLOR_GOOD);
	else
		SendSysMessage (who, "Пароли не совпадают!", FONT_BOLD, MESSAGE_COLOR_BAD);
		sendsysmessage (who, "Отменено");
		return;
	endif
 
endprogram
