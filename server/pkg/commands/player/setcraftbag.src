
use uo;
use os;

include "include/client";
include "include/objtype";
//include "include/itemtypes";

///////////////////
//  set the bag into which the crafted items will go
///////////////////

program SetCraftBag (who)
	SendSysMessage (who, "Выберите контейнер для созданных или добытых предметов.", color := 88);
	SendSysMessage (who, "Укажите себя или нажмите <esc>, чтобы использовать основной рюкзак.", color := 88);
	var bag := Target(who);
	if (!bag)
		SendSysMessage (who, "Созданные или добытые предметы будут помещаться в рюкзак.", color := 66);
		EraseObjProperty (who, "craftingbagserial");
		return;
	endif

	if (bag == who)
		SendSysMessage (who, "Созданные или добытые предметы будут помещаться в основной рюкзак.", color := 66);
		EraseObjProperty (who, "craftingbagserial");
		return;
	endif

	if (!InInventory (who.backpack, bag) )
		SendSysMessage (who, "Этого нет в вашем инвентаре.", color := 33);
		return;
	endif

	if (!bag.isa (POLCLASS_CONTAINER) )
				SendSysMessage (who, "В это нельзя ничего положить!", color := 33);
				return 0;
	endif

	SetObjProperty (who, "craftingbagserial", bag.serial);
	SendSysMessage (who, "Всё, что вы создадите или добудете, будет помещаться в этот контейнер.", color := 66);
endprogram

function InInventory(byref inventory, byref it)

	foreach item in EnumerateItemsInContainer(inventory)
		if (item == it)
			return 1;
		endif
	endforeach

	return 0;

endfunction

