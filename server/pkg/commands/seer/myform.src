use os;
use uo;

program my_form( who, help )

	if (help)
			SendSysMessage(who, "Команда возвращает обычный облик. .gmform — облик ГМ", color := 88);
			return 0;
	endif

	var myForm := GetObjProperty(who, "MyForm");

	if( !myForm )
		SendSysMessage(who, "Возможно, вы не использовали .gmform. Впредь сначала используйте её.", color := 36);
		if(who.gender == 1)
			myForm := 0x191;
		else
			myForm := 0x190;
		endif
	endif

	who.graphic := CInt(myForm);
	EraseObjProperty(who, "MyForm");
	SendSysMessage(who, "Вы больше не в облике ГМ.", color := 88);

endprogram
