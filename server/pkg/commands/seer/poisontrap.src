use uo;

include ":traps:traps";

program DartTrap(who, strngth)

	if (!strngth)
		strngth := "4d5";
	endif
	SendSysMessage(who,"Выберите контейнер для установки ловушки:", color := 88);
	var chest := Target(who);
	if (!chest)
		SendSysMessage(who,"отменено");
		return;
	endif
	if( !chest.IsA(POLCLASS_CONTAINER) )
		SendSysMessage( who, "Ловушки можно ставить только на контейнеры.", color := 33 );
		return;
	endif
	AddTrap(chest, "Gas", strngth, 1);
	SendSysMessage( who, "A gas trap is set on " + chest.name, color := 66 );

endprogram

