use uo;

program textcmd_create( who, text )
  if(text)
    var params := SplitWords( text );
    var objtype := CInt( params[1] );
    var amount := CInt( params[2] );
    if (!objtype)
        objtype := GetObjtypeByName( params[1] );
    endif
    if (!amount)
        amount := 1;
    endif
    if(amount > 10)
      SendSysMessage(who, "Недопустимо, ГМ! [создавать не более 10]");
      return;
    endif
    SendSysMessage(who, "Тип: " + CInt(objtype));
    var i, item;
	var targ := TargetCoordinates(who);
    for( i := 1; i <= amount; i := i + 1 )
      // item := CreateItemInBackpack(who, objtype, 1);
	  item := CreateItemAtLocation(targ.x, targ.y, targ.z, objtype, 1, who.realm);
	  item.z := 30;
      if(item)
        SetObjProperty(item, "Created", who.name);
//        item.decayAt := 0;
      else
        SendSysMessage( who, "Не удалось создать: " + item.errortext + ". Возможно, рюкзак полон.", 2, 33 );
      endif
    endfor
  else
    SendSysMessage(who, "Отменено");
    return;
  endif
endprogram