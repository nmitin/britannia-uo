use uo;

program teleto(who)
  SendSysMessage(who, "Кого переместить?");
  var what := Target(who);
  if(!what)
    return;
  endif
  SendSysMessage(who, "Куда переместить?");
  var where := TargetCoordinates(who);
  if(!where)
    return;
  endif
  MoveObjectToLocation(what, where.x, where.y, where.z, where.realm, MOVEOBJECT_FORCELOCATION);
endprogram