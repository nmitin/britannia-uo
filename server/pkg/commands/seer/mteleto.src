use uo;
use os;

program teleto(who)
  SendSysMessage(who, "Кого переместить?");
  var what := Target(who);
  SendSysMessage(who, "Куда переместить?");
  var where := TargetCoordinates(who);
  var chk := 0;
  while(chk == 0)
    if(what.isa(POLCLASS_MOBILE))
      what.facing := who.facing;
    else
      SendSysMessage(who, "Отменено");
      chk := 1;
    endif
    MoveObjectToLocation(what, where.x, where.y, where.z, what.realm, MOVEOBJECT_FORCELOCATION);
    SendSysMessage(who, "Кого переместить?");
    what := Target(who);
    if(!what)
      chk := 1;
    endif
    SendSysMessage(who, "Куда переместить?");
    where := TargetCoordinates(who);
    if(!where)
      chk := 1;
    endif
  endwhile
endprogram