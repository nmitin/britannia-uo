use uo;

program textcmd_lockdown(who)

        SendSysMessage(who, "Выберите цель.");
        var what := Target(who, TGTOPT_NOCHECK_LOS);

        if (!what)
                SendSysMessage(who, "Прервано.");
                return;
        endif

        if (what.movable == 0)
                SendSysMessage(who, "Освобождено.");
                what.movable := 1;
				what.decayat := ReadGameClock() + 600;
        else
                SendSysMessage(who, "Закреплено.");
                what.movable := 0;
        endif

endprogram