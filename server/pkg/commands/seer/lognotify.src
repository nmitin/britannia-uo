use uo;

program textcmd_lognotify(who)

	var notostatus := CInt(GetObjProperty(who, "LogNotify") );

	if (notostatus == 1)
		SendSysMessage(who, "Вы больше не будете получать уведомления о входе игроков.");
		EraseObjProperty(who, "LogNotify");
	else
		SendSysMessage(who, "Теперь вы будете получать уведомления о входе игроков.");
		SetObjProperty(who, "LogNotify", 1);
	endif

endprogram