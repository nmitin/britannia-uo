use uo;

program goto_serial(who, text)

	if(!text)
		SendSysMessage(who, "Нужно ввести серийный номер.", color := 33);
		return;
	endif
	var obj := SystemFindObjectBySerial(CInt(text));
	if(!obj)
		SendSysMessage(who, "Объекта с таким номером нет.", color := 40);
		return;
	endif
	MoveObjectToLocation(who, obj.x, obj.y, obj.z, obj.realm, MOVEOBJECT_FORCELOCATION);

endprogram