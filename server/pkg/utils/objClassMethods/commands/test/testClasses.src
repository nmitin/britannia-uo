use uo;
use os;
use guilds;
use party;

program textcmd_testclasses( mobile )
	var classes := Array{ "UObject", "Mobile", "NPC", "Item", "Equipment", "Armor", "Weapon", "Lockable", "Door", "Container",
						"Spellbook", "Corpse", "Map", "Multi", "Boat", "House" };

	var offline_ref := SystemFindObjectBySerial( 0x1B4, SYSFIND_SEARCH_OFFLINE_MOBILES );
	if( offline_ref.IsPlayer() )
		SendSysMessage( mobile, "Эверест действительно игрок", 0x3, 0x42 );
	endif

	SendSysMessage( mobile, "Выберите предмет для проверки методов класса.", 0x3, 0x42 );
	var targ := TargetCoordinates( mobile );

	var i := 1;
	for( i:=1; i<=classes; i+=1 )
		case( classes[i] )
			"UObject"	:
							if( targ.multi.IsUObject() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Mobile"	:
							if( targ.multi.IsPlayer() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif

							if( targ.multi.client.GetTime() )
								SendSysMessage( mobile, "Время клиента: "+targ.client.GetTime(),0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif

							if( targ.multi.guild )
								var guild_ref := FindGuild( targ.guildid );
								SendSysMessage( mobile, "Цвет гильдии: "+guild_ref.GetColor(), 0x3, 0x42 );
							endif

							if( targ.multi.party )
								SendSysMessage( mobile, "Партия: "+targ.party.Mood(), 0x3, 0x42 );
							endif
			"NPC"		:
							if( targ.multi.IsNPC() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Item"		:
							if( targ.multi.IsItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Equipment"	:
							if( targ.multi.IsEquipment() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Armor"		:
							if( targ.multi.IsArmorItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Weapon"	:
							if( targ.multi.IsWeaponItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Lockable"	:
							if( targ.multi.IsLockableItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Door"		:
							if( targ.multi.IsDoorItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Container"	:
							if( targ.multi.IsContainerItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Spellbook"	:
							if( targ.multi.IsSpellbookItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Corpse"	:
							if( targ.multi.IsCorpseItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Map"		:
							if( targ.multi.IsMapItem() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Multi"		:
							if( targ.multi.IsMulti() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"Boat"		:
							if( targ.multi.IsBoat() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
			"House"		:
							if( targ.multi.IsHouse() )
								SendSysMessage( mobile, "Это "+classes[i]+" предмет.",0x3, 0x42 );
							else
								SendSysMessage( mobile, "Это не "+classes[i]+" предмет.",0x3, 0x22 );
							endif
		endcase
		Sleep( 1 );
	endfor

	return 1;
endprogram