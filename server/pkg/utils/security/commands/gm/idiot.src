use uo;

program textcmd_idiot( mobile )

	SendSysMessage( mobile, "Что вы хотите проверить?" );
	var targ := Target( mobile, TGTOPT_NOCHECK_LOS );
	if( !targ )
                SendSysMessage( mobile, "Отменено." );
		return 0;
	endif

        var idiot := GetObjProperty( targ, "Idiot" );
        if( !idiot )
                SendSysMessage( mobile, "Идиот не найден.", 3, 70 );
                return 0;
        endif
        
        SendSysMessage( mobile, "Идиот найден! Серийный номер: "+idiot, 3, 33 );

        return 1;
endprogram
