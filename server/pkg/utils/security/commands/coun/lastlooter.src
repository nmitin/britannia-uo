use uo;

program textcmd_lastLooter( mobile )

	SendSysMessage( mobile, "Что вы хотите оценить?" );
	var targ := Target( mobile, TGTOPT_NOCHECK_LOS );
	if( !targ )
                SendSysMessage( mobile, "Отменено." );
		return 0;
	elseif( !targ.IsA( POLCLASS_CONTAINER ))
		SendSysMessage( mobile, "Вы ничего не находите." );
		return 0;
	endif
 
        var answer;
        var Last_Loot := GetObjProperty( targ, "LastLoot" );
        if( Last_Loot )
                answer := SystemFindObjectBySerial( Last_Loot[1] );
                SendSysMessage( mobile, "Вижу, это обыскал "+answer.name+"." );
        else
                SendSysMessage( mobile, "Нет, ничего не нахожу..." );
                return 0;
        endif

        return 1;
endprogram
