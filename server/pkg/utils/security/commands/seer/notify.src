use uo;

program textcmd_notify( mobile )

	var status := GetObjProperty( mobile, "Notify" );

        if( !status )
             SetObjProperty( mobile, "Notify", 1 );
             SendSysMessage( mobile, "*Уведомления администрации ВКЛ*", 3, 70 );
        else
             EraseObjProperty( mobile, "Notify" );
             SendSysMessage( mobile, "*Уведомления администрации ВЫКЛ*", 3, 33 );
        endif

        return 1;
endprogram
