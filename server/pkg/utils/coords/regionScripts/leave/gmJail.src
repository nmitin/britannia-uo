use uo;

program EnterRegionZone(mobile, region_name)

	if ( mobile.cmdlevel >= 2 )
		SendSysMessage(mobile, "Пойду проверю игроков. (Выход из "+region_name+")");
		return 1;
	else
		SendSysMessage(mobile, "Иди отсюда и веди себя хорошо.");
		mobile.Disable("invul");
		return 1;
	endif

        return 1;
endprogram
