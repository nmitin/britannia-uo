use uo;

program EnterRegionZone(mobile, region_name)
	
	mobile.GrantPrivilege("invul");
	mobile.Enable("invul");
	
	if ( mobile.cmdlevel )
		SendSysMessage(mobile, "Ах, ещё один тяжёлый день в офисе. (Вход в "+region_name+")");
		return 1;
	else 
		SendSysMessage(mobile, "Вы в тюрьме ГМ. Дождитесь помощи.");
		return 1;
	endif
	
        return 1;
endprogram
