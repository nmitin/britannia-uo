/* $Id$
 *
 */
use uo;
use os;

include ":attributes:attributes";
include ":damage:damage";

program PoisonScript(params)
	var mobile := params[1];

	var duration := CInt(GetObjProperty(mobile, "DarkBorer"));
	if ( !duration )
		duration := 90;
	endif

	do
		Sleep(60);
		duration := CInt(GetObjProperty(mobile, "DarkBorer"));
		if ( duration == error )
			duration := 90;
		endif

		if ( mobile.dead )
			continue; // Ghosts cant have birth!
		else
			duration -= 1;
			SetObjProperty(mobile, "DarkBorer", duration);
		endif

		case ( duration )
			89: SendSysMessage(mobile, "У вас болит живот."); break;
			60: SendSysMessage(mobile, "Вы чувствуете узел в животе."); break;
			50: SendSysMessage(mobile, "Ваш живот начинает раздуваться."); break;
			40: SendSysMessage(mobile, "Вы чувствуете резкую боль в животе."); break;
			35: SendSysMessage(mobile, "Вы чувствуете резкую боль в животе."); break;
			25: SendSysMessage(mobile, "Вы чувствуете, как что-то острое колет внутри."); break;
			15: SendSysMessage(mobile, "Вас пронзает острая боль по всему животу."); break;
			10: SendSysMessage(mobile, "Вы чувствуете, как ваши внутренности разрываются на части!"); break;
			1: SendSysMessage(mobile, "Вы чувствуете, что что-то готово вырваться наружу!"); break;
		endcase
	dowhile( duration > 0 );

	PrintTextAbove(mobile, "*Тёмный сверлильщик, созревавший в "+mobile.name+": живот — вырывается наружу!*", 3, 55);
	CreateNPCFromTemplate(":brainai:darkborer", mobile.x, mobile.y, mobile.z, 0, mobile.realm);
	KillMobile(mobile);

	SleepMS(100);
	if ( mobile.acctname && mobile.dead )
		sleepms(100);
		var corpse := mobile.GetCorpse();

		var tries := 10;
		while ( !corpse )
			SleepMS(10);
			corpse := mobile.GetCorpse();
			tries -= 1;
			if ( tries == 0 )
				break;
			endif
		endwhile
		SleepMS(20);

		if ( corpse )
			corpse.Gibbify(10);
		endif
	endif

	return 1;
endprogram
