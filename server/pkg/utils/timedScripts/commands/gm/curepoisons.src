use uo;

include ":timedScripts:timedScripts";
include ":timedScripts:poisonUtil";


program textcmd_curePoisons(who, text)
	text := SplitWords(text);

	var amount	:= CInt(text[1]);
	var type	:= CStr(text[2]);
	var level	:= CInt(text[3]);

	if ( !amount || !type || !level )
		SendSysMessage(who, "Синтаксис: .curePoisons <количество> <тип> <уровень>");
		return 0;
	endif

	SendSysMessage(who, "Выберите мобиля для излечения яда.");
	var targ := target(who);

	if ( !targ.IsA(POLCLASS_MOBILE) )
		SendSysMessage(who, "Отменено.");
		return 0;
	endif

	var num_cured := TS_CurePoison(targ, amount, type, level);
	SendSysMessage(who, "Готово. Излечено ядов: "+num_cured);
	return 1;
endprogram