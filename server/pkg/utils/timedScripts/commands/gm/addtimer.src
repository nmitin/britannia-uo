 *
 */
use uo;

include ":timedScripts:timedScripts";

program textcmd_AddTimer(who, params)
	params := SplitWords(params);

	var timer_name	:= params[1];
	var duration	:= CInt(params[2]);
	var level	:= CInt(params[3]);

	if ( !timer_name || !duration )
		SendSysMessage(who, "Синтаксис: .addtimer <длительность> (уровень)");
		return 0;
	elseif ( !level )
		level := 1;
	endif

	SendSysMessage(who, "Выберите существо.");
	var targ := Target(who);
	if ( !targ.IsA(POLCLASS_MOBILE) )
		SendSysMessage(who, "Отменено.");
		return 0;
	endif

	TS_StartTimer(targ, timer_name, duration, level);

	SendSysMessage(who, "Готово.");

	return 1;
endprogram

