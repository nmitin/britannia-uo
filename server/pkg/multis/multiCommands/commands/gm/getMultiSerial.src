use uo;
use os;

program textcommand_getMultiSerial( mobile )

        var targ := Target( mobile );
        if( !targ )
                SendSysMessage( mobile, "Отменено." );
                return 0;
        elseif( !targ.multi )
                SendSysMessage( mobile, "В этом месте нет мульти." );
                return 0;
        endif

	SendSysMessage( mobile, "Серийный номер мульти: "+targ.multi.serial );

        return 1;
endprogram
