use uo;
use cliloc;

include ":cleric:adjustSkills";
include ":cleric:cleric";
include ":cleric:faiths";
include ":attributes:attributes";

program excommunication(params)
	var who := params[1];
	var ritenum := params[2];

	var hp_devotion := GetObjProperty(who, "Преданность");
	SendSysMessage(who, "Выберите, кого хотите отлучить");
	var targ := Target(who);
	if(!targ)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return 0;
	endif
	var victim_devotion := GetObjProperty(targ, "Преданность");
	if (GetObjProperty(targ, "Преданность") == hp_devotion)
		if (IsCleric(targ) && !hpboost(who))
			SendSysMessage(who, "Только верховный жрец может отлучать членов и клириков.", color := 33);
			return 0;
		else

			// A high priest cannot excom someone from another faith.
			if(victim_devotion != hp_devotion)
				SendSysMessage(who, "Этот человек не вашей веры.", color := 33);
				return 0;
			endif
			// A high priest cannot excom himself.
			if(targ.serial == who.serial)
				SendSysMessage(who, "Нельзя отлучить самого себя!", color := 33);
				return 0;
			endif
			// Get the info from the faiths datafile.
			var faith := Faiths_FindFaith(hp_devotion);
			var member_list := faith.getprop("MemberList");
			var cleric_list := faith.getprop("ClericList");
			if(targ.serial in member_list)
				member_list.erase(targ.serial in member_list);
				faith.setprop("MemberList", member_list);
				PlaySoundEffect(targ, 519);
				EraseObjProperty( targ, "Преданность" );
				EraseObjProperty( targ, "Piety" );
			elseif(targ.serial in cleric_list)
				cleric_list.erase(targ.serial in cleric_list);
				faith.setprop("ClericList", cleric_list);
				PlaySoundEffect(targ, 519);
				SetObjProperty(targ, "Преданность", "Faithless");
				EraseObjProperty( targ, "Cleric" );
				EraseObjProperty( targ, "Piety" );
				// Restore previous skills
				ResetSkills(targ);
			else
				SendSysMessage(who, "Странно. Похоже, этот человек не", color := 33);
				SendSysMessage(who, "член и не клирик вашей веры.", color := 33);
				SendSysMessage(who, "Похоже, это ошибка. Сообщите администрации.", color := 33);
				return 0;
			endif
			SetAttributeBaseValue( targ, MEDITATION, CInt( CDbl( 40 ) * 10.0 ) );
			SendSysMessage(targ, "Вас отлучили от " + hp_devotion);
			SendSysMessage(who, targ.name + " отлучён от " + hp_devotion);
		endif
	endif
endprogram
