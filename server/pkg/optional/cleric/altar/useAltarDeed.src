use uo;
use cliloc;

include ":cleric:cleric";
include ":cleric:faiths";
include ":damage:damage";
include "include/housing";
include ":attributes:attributes";

var faithsdb := Faiths_OpenDatafile();

program UseAltar(who, altar_deed)
	var altar_devotion := GetObjProperty(altar_deed, "Преданность");
	var user_devotion := GetObjProperty(who, "Преданность");

	if(!altar_deed in EnumerateItemsInContainer(who.backpack))
		SendSysMessage(who, "Документ должен быть в рюкзаке.", color := 33);
		return;
	endif

	if(!hpboost(who))
		SendSysMessage(who, "Вы должны быть верховным жрецом, и святой символ", color := 33);
		SendSysMessage(who, "должен быть в руке при создании алтаря.", color := 33);
		return;
	endif

	if(GetGlobalProperty(user_devotion + "Altar"))
		SendSysMessage(who, "Алтарь " + user_devotion + " веры уже существует в мире.", color := 33);
		return;
	endif
	// Is this deed's devotion already set?.
	if (altar_devotion != "NONE")
		SendSysMessage(who, "Этот алтарь уже посвящён " + altar_devotion + " преданности.", color := 33);
		return;
	endif

	var hsign := GetHouseSign(who);
	if(!hsign.IsObjectInsideHouse(who))
		SendSysMessage(who, "Алтарь ставится только в доме.", color := 33);
		return;
	endif
	if(GetObjProperty(hsign, "Преданность"))
		SendSysMessage(who, "Это здание уже освящено другой вере.", color := 33);
		SendSysMessage(who, "Вам запрещено ставить " + user_devotion + " алтарь в этом нечестивом месте!", color := 33);
		PlayLightningBoltEffect(who);
		ApplyRawDamageEx(who, 10, DMG_ENERGY);
		return;
	endif
	SendSysMessage(who, "Куда поставить алтарь?", color := 88);
	var loc := TargetCoordinates(who);
	if(!loc)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return;
	endif
	if(!hsign.IsLocationInsideHouse(loc))
		SendSysMessage(who, "Алтари ставятся только внутри дома.", color := 33);
		return;
	endif

	if(!hsign.IsOwner(who))
		SendSysMessage(who, "Только владелец дома может поставить алтарь.", color := 33);
		return;
	endif

	var altar := CreateItemAtLocation(loc.x, loc.y, loc.z, "clericaltar", 1, loc.realm);
	if(!altar)
		SendSysMessage(who, "Здесь нельзя поставить алтарь.", color := 33);
		SendSysMessage(who, "Используйте документ снова в другом месте.", color := 33);
		return;
	endif
	var elem := faithsdb.FindElement(user_devotion);
	var faith_colour := elem.getprop("Color");
	altar.color := faith_colour;
	SetObjProperty(altar, "Преданность", user_devotion);
	SendSysMessage(who, "Алтарь посвящён " + user_devotion + " вере", color := 66);
	SendSysMessage(who, "и здание освящено.", color := 66);
	SetName(altar, "The " + user_devotion + " алтарь.");

	// Save the location of this altar.
	var faith := Faiths_FindFaith( user_devotion );
	if(!faith)
		faith := Faiths_AddFaith( user_devotion );
	endif
	if(!faith)
		SendSysMessage(who, "Не удалось найти или добавить эту веру в файл данных.", color := 33);
		SendSysMessage(who, "Сообщите администрации следующую ошибку:", color := 33);
		SendSysMessage(who, faith.errortext, color := 33);
		return;
	endif
	faith.setprop("AltarLoc", loc);
	// Set the house Devotion.
	SetObjProperty(hsign, "Преданность", user_devotion);
	SendSysMessage(who, "Где должен быть ваш дом?", color := 88);
	var untrodden_home := TargetCoordinates(who);
	faith.setprop("UntroddenHome", untrodden_home);
	SendSysMessage(who, "Место дома установлено.", color := 66);
	DestroyItem(altar_deed);

endprogram

