use uo;
use os;

include ":cleric:cleric";

program mypiety(who, text)
	if (!IsCleric(who))
		SendSysMessage(who, "Вы не клирик.");
		return;
	endif

	var devotion := GetObjProperty(who, "Преданность");
	var piety := GetObjProperty(who, "Piety");
	SendSysMessage(who, "Ваше благочестие: " + piety);
endprogram
