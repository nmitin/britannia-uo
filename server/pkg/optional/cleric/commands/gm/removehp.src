use uo;
use datafile;

include ":cleric:adjustSkills";
include ":cleric:cleric";
include ":cleric:faiths";
include ":gumps:requestGump";

var faiths_datafile := Faiths_OpenDatafile();

program make_high_priest(who)

	SendSysMessage(who, "Укажите игрока или <ESC>, если он офлайн:", color := 88);
	var victim := Target(who);
	// In the event the HP is offline.
	if(!victim)
		var devotion := RequestGump(who, "Enter the devotion:", "", "", CANCEL_BTN_ON);
		if(devotion == error)
			SendSysMessage(who, "Отменено", color := 33);
			return 0;
		endif
		var faith := Faiths_FindFaith( devotion );
		if(faith.errortext)
			SendSysMessage(who, "Не удалось найти преданность " + devotion + " в файле вер.", color := 33);
			SendSysMessage(who, "Проверьте написание. Если проблема остаётся,", color := 33);
			SendSysMessage(who, "сообщите администрации следующую ошибку.", color := 33);
			SendSysMessage(who, devotion.errortext, color := 33);
			return 0;
		endif
		var cur_hp := faith.getprop("HighPriest");
		victim := SystemFindObjectBySerial(cur_hp, SYSFIND_SEARCH_OFFLINE_MOBILES);
	endif
	var devotion := GetObjProperty(victim, "Преданность");
	if(!devotion || devotion == "Faithless")
		SendSysMessage(who, "Похоже, этот человек не в религии.", color := 33);
		return 0;
	endif
	var faith := Faiths_FindFaith( devotion );
	if(faith.errortext)
		SendSysMessage(who, "Не удалось найти преданность " + devotion + " в файле вер.", color := 33);
		SendSysMessage(who, "Сообщите администрации следующую ошибку.", color := 33);
		SendSysMessage(who, devotion.errortext, color := 33);
		return 0;
	endif
	var cur_hp := faith.getprop("HighPriest");
	if(victim.serial == cur_hp)
		PlaySoundEffect(victim, 519);
		SetObjProperty(victim, "Преданность", "Faithless");
		EraseObjProperty ( victim, "Cleric");
		EraseObjProperty (victim, "Piety");
		EraseObjProperty (victim, "PietyRewardTimer");
		cur_hp := faith.eraseprop("HighPriest");
		// Restore previous skills
		ResetSkills(victim);
	else
		SendSysMessage(who, "Этот человек не верховный жрец " + devotion + " веры.", color := 33);
	endif

endprogram

