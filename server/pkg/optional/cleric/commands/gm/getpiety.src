use uo;
use os;

include "include/client";


program GetPiety(who)
        var targ, Piety;
		SendSysMessage(who, "Выберите персонажа:", color := 88);
        targ := target(who);
        Piety := GetObjProperty (targ, "Piety");
        if (GetObjProperty (targ, "Piety"))
          SendSysMessage ( who, "Благочестие этого человека: " + Piety );
          else SendSysMessage ( who, "Этот человек без веры.");
          endif
endprogram
