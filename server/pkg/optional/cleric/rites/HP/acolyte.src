use uo;
use cliloc;

include ":cleric:adjustSkills";
include ":cleric:cleric";
include ":gumps:yesNo";

program setacolyte(params)
	var who := params[1];
	var info := params[2];

	var targ := target(who);

	if (!targ.ip)
		SendSysMessageCL(who, 1042023, color := 33); // Cancelled.
		return 0;

	elseif (GetObjProperty(who, "Преданность") != GetObjProperty(targ, "Преданность"))
		SendSysMessage(who, targ.name + " не вашей веры.", color := 33);
		SendSysMessage(who, "Сначала нужно посвятить этого человека.", color := 33);
		return 0;

	elseif (IsCleric(targ))
		SendSysMessage(who, targ.name + " уже клирик.", color := 33);
		return;
	elseif (!HPBoost(who) && !who.cmdlevel)
		SendSysMessage(who, "Вы не держите символ своей веры.", color := 33);
		return 0;
	endif

	makecleric(who, targ);
endprogram

function makecleric(who, targ)
	var devotion := GetObjProperty(who, "Преданность");
	var response := YesNo(targ, "Become a cleric of " + devotion + "?", "Yes", "No.");


	if (response)
		SetObjProperty(targ, "Cleric", GetObjProperty(who, "Cleric"));
		SetObjProperty(targ, "Piety", 1);
		SendSysMessage(who, targ.name + " теперь клирик " + devotion);
		SendSysMessage(targ, "Теперь вы клирик " + devotion);
		// Add this new cleric to the devotion's cleric list.
		var faith := Faiths_FindFaith(devotion);
		var cleric_list := faith.getprop("ClericList");
		if(!cleric_list)
			cleric_list := {};
		endif
		cleric_list.append(targ.serial);
		faith.setprop("ClericList", cleric_list);
		SetSkills (targ);
	else
		SendSysMessage(who, targ.name + " не желает быть клириком " + devotion);
		SendSysMessage(targ, "Вы отказались быть клириком " + devotion);
	endif
endfunction

