use uo;
use cliloc;

include ":cleric:cleric";
include ":gumps:yesNo";

program righteousness(params)
	var who := params[1];
	var info := params[2];

	var targ := ClericalTarget(who, info.npctarget);

	if (!targ.ip || targ == who)
		SendSysMessage(who, "Отменено");
		return;
	endif

	var title := "";

	if (!targ.murderer)
		title := "Mark this person as a murderer?";
		if (yesno(who, title))
			SendSysMessage(who, targ.name + " теперь преступник");
			SendSysMessage(targ, "Вы отмечены как убийца.");
			targ.murderer := 1;
			PlayObjectCenteredEffect(targ, 0x374a, 20, 20);
			PlaySoundEffect(targ, 482);
		else
			SendSysMessage(who, 1042023, color := 33); // Cancelled.
		endif
	else
		title := "Remove the murderer mark from this person?";
		if (yesno(who, title))
			SendSysMessage(who, targ.name + " больше не преступник.");
			SendSysMessage(targ, "Вы больше не отмечены как преступник.");
			targ.murderer := 0;
			PlayObjectCenteredEffect(targ, 14138, 10, 10);
			PlaySoundEffect(targ, 491);
		else
			SendSysMessage(who, 1042023, color := 33); // Cancelled.
		endif
	endif
endprogram
