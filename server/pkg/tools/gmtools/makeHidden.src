use os;
use uo;

program makhidden(who)
    if (who.cmdlevel < 2)
      return;
    endif
    SendSysMessage( who, "Выберите предмет, чтобы скрыть." );
    var item := Target( who, TGTOPT_NOCHECK_LOS );
    if (!item)
      SendSysMessage(who, "Выбор цели отменён.");
      return;
    endif
    item.invisible := 1;
endprogram