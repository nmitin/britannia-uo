//
// Destroy an item even if marked by "Static" CProp
//

use uo;

program textcmd_udestroy( who )
	SendSysMessage(who, "Эта команда уничтожает только предметы,", color := 88);
	SendSysMessage(who, "размещённые командой decoratefacets", color := 88);
	SendSysMessage( who, "Укажите, что уничтожить.", 1, 88 );
	SendSysMessage( who, "Нажмите <ESC>, когда закончите..", 1, 88 );
	while(1)
		var tgt := Target( who );
		if(!tgt)
			SendSysMessage(who, "Отменено.", 1, 33);
			return 0;
		endif
		if(!GetObjProperty(tgt, "DecorateFacetsStatic"))
			SendSysMessage(who, "Этой командой можно уничтожать только предметы,", color := 40);
			SendSysMessage(who, "размещённые командой decoratefacets.", color := 40);
		elseif(!tgt.isA(POLCLASS_NPC) || !tgt.client)
			DestroyItem( tgt);
		else
		SendSysMessage( who, "Уничтожать можно только предметы", 1, 33 );
		endif
	endwhile
endprogram