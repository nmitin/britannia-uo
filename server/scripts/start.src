use uo;
use os;

include "include/teleporters";
include "include/worlddoors";
include "include/worlddecor";
include "include/worldteleporters";
include "include/worldguards";
include "include/worldmerchants";
include "include/worldspecials";
include "include/testplayers";
include ":containers:storageAreas";

program world_start_up()

	foreach name in ( CP_ListStorageAreas() )
		CP_GetStorageArea( name, CP_CREATE );
		Print( "Initializing "+name+" Area." );
	endforeach
	Start_Script( "storageWipe" );
	Print( "Wiping merchant storage" );

	Print( "Initializing teleporters" );
	CreateTeleporters();

	Print( "Размещение дверей мира" );
	var doors := WorldDoorsPlace();
	if( doors.Message )
		Print( "WorldDoors: " + doors.Message );
	else
		Print( "WorldDoors: всего " + doors.Total + ", создано " + doors.Created +
		       ", уже было " + doors.Existing + ", ошибок " + doors.Failed +
		       ", закрыто открытых " + doors.Closed );
	endif

	Print( "Размещение мирового декора" );
	var decor := WDPlace();
	if( decor.Message )
		Print( "WorldDecor: " + decor.Message );
	else
		Print( "WorldDecor: всего " + decor.Total + ", создано " + decor.Created +
		       ", уже было " + decor.Existing + ", ошибок " + decor.Failed );
	endif

	Print( "Размещение dungeon-телепортов" );
	var teles := WorldTPPlace();
	if( teles.Message )
		Print( "WorldTeleporters: " + teles.Message );
	else
		Print( "WorldTeleporters: всего " + teles.Total + ", создано " + teles.Created +
		       ", уже было " + teles.Existing + ", ошибок " + teles.Failed );
	endif

	Print( "Размещение guard-постов" );
	var guards := WGPlace();
	if( guards.Message )
		Print( "WorldGuards: " + guards.Message );
	else
		Print( "WorldGuards: всего " + guards.Total + ", создано " + guards.Created +
		       ", уже было " + guards.Existing + ", ошибок " + guards.Failed );
	endif

	Print( "Размещение merchant-узлов" );
	var merchants := WMSeed();
	if( merchants.Message )
		Print( "WorldMerchants: " + merchants.Message );
	else
		Print( "WorldMerchants: всего " + merchants.Total + ", создано " + merchants.Created +
		       ", уже было " + merchants.Existing + ", ошибок " + merchants.Failed );
	endif

	Print( "Размещение особых NPC" );
	var specials := WSPlace();
	if( specials.Message )
		Print( "WorldSpecials: " + specials.Message );
	else
		Print( "WorldSpecials: всего " + specials.Total + ", создано " + specials.Created +
		       ", уже было " + specials.Existing + ", ошибок " + specials.Failed );
	endif

	Print( "Посев бродячих лекарей" );
	var healers := WSSeedHealers();
	if( healers.Message )
		Print( "WorldSpecials: " + healers.Message );
	else
		Print( "Бродячие лекари: всего " + healers.Total + ", создано " + healers.Created +
		       ", уже было " + healers.Existing + ", ошибок " + healers.Failed );
	endif

	Print( "Тестовые персонажи: проверка аккаунтов" );
	var testplayers := TPEnsureAccounts();
	if( testplayers.Message )
		Print( "TestPlayers: " + testplayers.Message );
	endif
	Print( "TestPlayers: аккаунтов создано " + testplayers.Created +
	       ", уже было " + testplayers.Existing + ", ошибок " + testplayers.Failed );

	return 1;
endprogram