/////////////////////////////////////////////////////////////////////////////
//
// sailto.src - "морское путешествие" с капитаном (порт из World of Dream).
//
// Капитан отправляет игрока на свой корабль, стоящий в открытом море:
//   * корабль (мульти LargeBoat 0x11010) ставится в первой подходящей
//     стоянке из списка Moorings() - там, где весь корпус на чистой воде;
//   * серийник корабля хранится в global property FerryShip.Serial,
//     поэтому повторные плавания его переиспользуют, а старые стоянки
//     (в т.ч. наследная 1440,1854) зачищаются;
//   * игрок появляется на палубе, 15-22 секунды звучат волны, затем
//     сходит в порту назначения (ближайшая проходимая точка - доки из WoD
//     на нашей карте местами попадают в воду или в стену).
//
// Источник: src/WorldOfDream/scripts/misc/sailto.src (POL 098).
//
/////////////////////////////////////////////////////////////////////////////

use uo;
use os;

// Стоянки корабля-парома. Проверены по realm/britannia/maptile.dat (вода
// 0xA8-0xAB, z=-5, окно >= 25x25 под корпус LargeBoat) и на живом сервере:
// 2398,1760 ядро принимает, 1450,1565 отвергло ("Position indicated is
// impassable" — в воде статики). Первая - основная, вторая - запасная.
function Moorings()

	return {
		{ 2398, 1760, -5 },
		{ 1498, 1758, -5 }
	};
endfunction

const SHIP_MULTI := 0x11010;       // LargeBoat (MultiID 0x10), нос на север
const SHIP_CPROP := "FerryShip";
const SHIP_REG := "FerryShip.Serial";
const ABOARD_RADIUS := 6;          // докуда считаем, что игрок на корабле
const LEASH_RADIUS := 14;          // дальше - значит ушёл магией
// Стоянка, с которой начинался раунд: корабль там надо убрать.
const LEGACY_X := 1440;
const LEGACY_Y := 1854;

program SailToDestination( parms )

	var you := parms[1];
	var sailto := parms[2];

	var ship := FerryShip();
	var ship_ok := !ship.errortext;

	if( ship_ok )
		Print( "SailTo: " + you.name + " на палубу " + ship.x + "," + ship.y + "," +
		       ship.z + " (корабль " + ship.serial + ")" );
		MoveObjectToLocation( you, ship.x, ship.y, ship.z, _DEFAULT_REALM,
		                      MOVEOBJECT_FORCELOCATION );
	else
		// Корабль не встал: не телепортируем молча, а всё равно "везём"
		// с обычной задержкой и высадкой в порту.
		Print( "SailTo: " + ship.errortext + " - везём " + you.name + " без корабля" );
		SendSysMessage( you, "Капитан чертыхается: корабль не на месте, но довезу." );
	endif

	for i := 1 to CInt( sailto[4] )
		Sleep( 2 );
		PlaySoundEffect( you, 0x13 );
		Sleep( 2 );
		PlaySoundEffect( you, 0x14 );
		if( ship_ok && !StillAboard( you, ship ) )
			if( CoordinateDistance( you.x, you.y, ship.x, ship.y ) <= LEASH_RADIUS )
				// Шагнул за борт - возвращаем на палубу.
				MoveObjectToLocation( you, ship.x, ship.y, ship.z, _DEFAULT_REALM,
				                      MOVEOBJECT_FORCELOCATION );
			else
				// Реколл/гейт: поездка отменяется.
				EraseObjProperty( you, "sailto" );
				return;
			endif
		endif
	endfor

	Sleep( 3 );

	if( !ship_ok || StillAboard( you, ship ) )
		var landing := FindLanding( sailto[1], sailto[2], sailto[3] );
		var res := MoveObjectToLocation( you, landing.x, landing.y, landing.z, _DEFAULT_REALM,
		                                 MOVEOBJECT_FORCELOCATION );
		if( res.errortext )
			// Например, игрок вышел из игры во время плавания. CProp sailto
			// не стираем: logon.src довезёт его в порт при следующем входе.
			Print( "SailTo: не удалось высадить " + you.name + ": " + res.errortext );
		else
			Print( "SailTo: " + you.name + " высажен в " + you.x + "," + you.y + "," + you.z );
			EraseObjProperty( you, "sailto" );
		endif
	endif

endprogram


// Находит корабль-паром или создаёт его в первой подходящей стоянке.
function FerryShip()

	CleanupOldFerries();

	var reg := GetGlobalProperty( SHIP_REG );
	var serial := 0;
	if( TypeOf( reg ) == "Integer" )
		serial := reg;
	endif

	if( serial )
		var old := SystemFindObjectBySerial( serial );
		if( old )
			return old;
		endif
	endif

	foreach spot in Moorings()
		var ship := CreateMultiAtLocation( spot[1], spot[2], spot[3], SHIP_MULTI, 0, _DEFAULT_REALM );
		if( ship.errortext )
			Print( "SailTo: стоянка " + spot[1] + "," + spot[2] + " не подошла: " + ship.errortext );
			continue;
		endif
		SetObjProperty( ship, SHIP_CPROP, 1 );
		SetGlobalProperty( SHIP_REG, ship.serial );
		Print( "SailTo: корабль-паром поставлен в " + ship.x + "," + ship.y );
		return ship;
	endforeach

	return error{ "errortext":="не удалось поставить корабль-паром ни в одной стоянке" };
endfunction


// Убирает корабли, оставшиеся на прежних стоянках.
function CleanupOldFerries()

	var legacy := { { LEGACY_X, LEGACY_Y } };
	foreach spot in legacy
		foreach multi in ListMultisInBox( spot[1] - 6, spot[2] - 6, -15,
		                                  spot[1] + 6, spot[2] + 6, 5, _DEFAULT_REALM )
			if( GetObjProperty( multi, SHIP_CPROP ) )
				Print( "SailTo: убран старый корабль-паром в " + multi.x + "," + multi.y );
				DestroyMulti( multi );
			endif
			SleepMS( 2 );
		endforeach
	endforeach
endfunction


// Ближайшая точка, где персонаж реально может стоять (док, пирс, берег).
function FindLanding( x, y, z )

	var coords := GetStandingCoordinates( x, y, 10, z - 25, z + 25, _DEFAULT_REALM, "L", 0 );
	if( coords.Size() == 0 )
		coords := GetStandingCoordinates( x, y, 25, z - 50, z + 50, _DEFAULT_REALM, "L", 0 );
	endif
	if( coords.Size() == 0 )
		Print( "SailTo: рядом с " + x + "," + y + " нет проходимой точки, высаживаю как есть" );
		return struct{ "x":=x, "y":=y, "z":=z };
	endif

	var best := 0;
	var best_dist := 100000;
	foreach coord in coords
		if( !Landable( coord.x, coord.y ) )
			continue;
		endif
		var dist := CoordinateDistance( x, y, coord.x, coord.y );
		if( dist < best_dist )
			best_dist := dist;
			best := coord;
		endif
		SleepMS( 2 );
	endforeach
	if( !best )
		Print( "SailTo: рядом с " + x + "," + y + " только вода, высаживаю в исходную точку" );
		return struct{ "x":=x, "y":=y, "z":=z };
	endif
	return best;
endfunction


// На чистой воде POL тоже отдаёт "стоячие" координаты (плавание), поэтому
// проверяем: либо суша, либо над водой есть статика/мульти (пирс, палуба).
function Landable( x, y )

	var info := GetMapInfo( x, y, _DEFAULT_REALM );
	if( !( info.landtile in { 0xA8, 0xA9, 0xAA, 0xAB, 0x244, 0x64 } ) )
		return 1;
	endif
	return ( ListStaticsAtLocation( x, y, LIST_IGNORE_Z, 0, _DEFAULT_REALM ).Size() > 0 );
endfunction


function StillAboard( who, ship )

	return ( CoordinateDistance( who.x, who.y, ship.x, ship.y ) <= ABOARD_RADIUS );

endfunction
