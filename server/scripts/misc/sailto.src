/////////////////////////////////////////////////////////////////////////////
//
// sailto.src - "морское путешествие" с капитаном (порт из World of Dream).
//
// Капитан отправляет игрока на свой корабль, стоящий в открытом море:
//   * корабль (мульти 0x10, "long boat") создаётся один раз в точке
//     SHIP_X/SHIP_Y и живёт в мире постоянно - он помечен CProp FerryShip,
//     поэтому повторные плавания его переиспользуют, а не плодят флот;
//   * игрок появляется на палубе (координата ищется по GetStandingCoordinates,
//     чтобы реально стоять на палубе, а не висеть в воде);
//   * 15-22 секунды звучат волны, затем игрок сходит в порту назначения.
//
// Если игрок сошёл с палубы рядом с кораблём - его возвращают на палубу,
// а если ушёл магией/реколлом далеко - поездка отменяется.
//
// Источник: src/WorldOfDream/scripts/misc/sailto.src (POL 098).
//
/////////////////////////////////////////////////////////////////////////////

use uo;
use os;

// Точка стоянки корабля-парома. Выбрана по realm/britannia/maptile.dat
// (данные с учётом mapdif-патчей) как самое чистое место в открытой воде
// к северо-востоку от Британии: в окне 51x51 вокруг только мелкие скалы,
// до ближайшего берега ~20 тайлов (в морях Британии это максимум).
const SHIP_X := 1638;
const SHIP_Y := 1514;
const SHIP_Z := -5;
const SHIP_MULTI := 0x11010;       // LargeBoat (MultiID 0x10), нос на север
const SHIP_CPROP := "FerryShip";
const SHIP_REG := "FerryShip.Serial";
const ABOARD_RADIUS := 6;          // докуда считаем, что игрок на корабле
const LEASH_RADIUS := 14;          // дальше - значит ушёл магией

program SailToDestination( parms )

	var you := parms[1];
	var sailto := parms[2];

	var ship := FerryShip();
	if( ship.errortext )
		Print( "SailTo: не удалось поставить корабль: " + ship.errortext );
		MoveObjectToLocation( you, sailto[1], sailto[2], sailto[3], _DEFAULT_REALM,
		                      MOVEOBJECT_FORCELOCATION );
		EraseObjProperty( you, "sailto" );
		return;
	endif

	var deck := FerryDeck( ship );
	Print( "SailTo: " + you.name + " на палубу " + deck.x + "," + deck.y + "," +
	       deck.z + " (корабль " + ship.serial + ")" );
	MoveObjectToLocation( you, deck.x, deck.y, deck.z, _DEFAULT_REALM,
	                      MOVEOBJECT_FORCELOCATION );

	for i := 1 to CInt( sailto[4] )
		Sleep( 2 );
		PlaySoundEffect( you, 0x13 );
		Sleep( 2 );
		PlaySoundEffect( you, 0x14 );
		if( !StillAboard( you ) )
			if( CoordinateDistance( you.x, you.y, SHIP_X, SHIP_Y ) <= LEASH_RADIUS )
				// Шагнул за борт - возвращаем на палубу.
				deck := FerryDeck( ship );
				MoveObjectToLocation( you, deck.x, deck.y, deck.z, _DEFAULT_REALM,
				                      MOVEOBJECT_FORCELOCATION );
			else
				// Реколл/гейт: поездка отменяется.
				EraseObjProperty( you, "sailto" );
				return;
			endif
		endif
	endfor

	Sleep( 3 );

	if( StillAboard( you ) )
		// Часть доков из WoD на нашей карте приходится на воду/стену -
		// ищем ближайшую нормальную точку высадки.
		var landing := FindLanding( sailto[1], sailto[2], sailto[3] );
		var res := MoveObjectToLocation( you, landing.x, landing.y, landing.z, _DEFAULT_REALM,
		                                 MOVEOBJECT_FORCELOCATION );
		if( res.errortext )
			Print( "SailTo: не удалось высадить " + you.name + ": " + res.errortext );
		else
			Print( "SailTo: " + you.name + " высажен в " + you.x + "," + you.y + "," + you.z );
		endif
	endif
	EraseObjProperty( you, "sailto" );

endprogram


// Находит корабль-паром или создаёт его. Глобальное свойство хранит серийник,
// поэтому при смене стоянки старый корабль убирается, а не плодится новый.
function FerryShip()

	CleanupOldFerries();

	var serial := CInt( GetGlobalProperty( SHIP_REG ) );
	if( serial )
		var old := SystemFindObjectBySerial( serial );
		if( old && old.x == SHIP_X && old.y == SHIP_Y && old.z == SHIP_Z )
			return old;
		elseif( old )
			DestroyMulti( old );
			Print( "SailTo: старый корабль-паром убран со старой стоянки" );
		endif
	endif

	var ship := CreateMultiAtLocation( SHIP_X, SHIP_Y, SHIP_Z, SHIP_MULTI, 0, _DEFAULT_REALM );
	if( ship.errortext )
		return ship;
	endif

	SetObjProperty( ship, SHIP_CPROP, 1 );
	SetGlobalProperty( SHIP_REG, ship.serial );
	Print( "SailTo: корабль-паром поставлен в " + SHIP_X + "," + SHIP_Y );
	return ship;
endfunction


// Убирает корабли, оставшиеся на прежних стоянках (до появления реестра).
function CleanupOldFerries()

	var legacy := { { 1440, 1854 } };
	foreach spot in legacy
		if( spot[1] == SHIP_X && spot[2] == SHIP_Y )
			continue;
		endif
		foreach multi in ListMultisInBox( spot[1] - 6, spot[2] - 6, SHIP_Z - 10,
		                                  spot[1] + 6, spot[2] + 6, SHIP_Z + 10, _DEFAULT_REALM )
			if( GetObjProperty( multi, SHIP_CPROP ) )
				DestroyMulti( multi );
				Print( "SailTo: убран старый корабль-паром в " + multi.x + "," + multi.y );
			endif
			SleepMS( 2 );
		endforeach
	endforeach
endfunction


// Палуба корабля. В определении корпуса (config/multis.cfg, Boat 0x10)
// первая deck-плитка стоит в относительных координатах 0,0,0, поэтому
// центр мульти и есть палуба: z корабля = z палубы.
function FerryDeck( ship )

	return struct{ "x":=SHIP_X, "y":=SHIP_Y, "z":=SHIP_Z };
endfunction


// Ближайшая точка, где персонаж реально может стоять (док, пирс, берег).
function FindLanding( x, y, z )

	var coords := GetStandingCoordinates( x, y, 10, z - 25, z + 25, _DEFAULT_REALM, "L", 0 );
	if( coords.Size() == 0 )
		coords := GetStandingCoordinates( x, y, 25, z - 50, z + 50, _DEFAULT_REALM, "L", 0 );
	endif
	if( coords.Size() == 0 )
		return struct{ "x":=x, "y":=y, "z":=z };
	endif

	var best := coords[1];
	var best_dist := 100000;
	foreach coord in coords
		var dist := CoordinateDistance( x, y, coord.x, coord.y );
		if( dist < best_dist )
			best_dist := dist;
			best := coord;
		endif
		SleepMS( 2 );
	endforeach
	return best;
endfunction


function StillAboard( who )

	return ( CoordinateDistance( who.x, who.y, SHIP_X, SHIP_Y ) <= ABOARD_RADIUS );

endfunction
