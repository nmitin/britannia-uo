use os;
use uo;

const SEARCH_RANGE := 10;
const TRASH_BARREL := 0x17007;

program maketrash( who, deed )

  ReserveItem(deed);
  SendSysMessage( who, "Где разместить мусорный бак?");
  var where := TargetCoordinates( who );
  var place;
  if(!where)
    SendSysMessage( who, "Отменено");
    return;
  else
    if(!checkfortrashcans(where, who.realm))
      place := CreateItemAtLocation( where.x, where.y, where.z, TRASH_BARREL, 1, who.realm );
    else
      SendSysMessage( who, "Здесь нельзя разместить мусорный бак");
      return;
    endif
  endif
  if(!place)
    SendSysMessage( who, "Мусорный бак не создан");
    return;
  else
    SendSysMessage( who, "Мусорный бак успешно создан");
    DestroyItem(deed);
  endif
endprogram

function checkfortrashcans(place, map)
  var stuff := ListItemsNearLocation( place.x, place.y,place.z,SEARCH_RANGE, map);
  foreach item in stuff
	if(item.objtype == TRASH_BARREL)
	  return 1;
	endif
  endforeach
  return 0;
endfunction