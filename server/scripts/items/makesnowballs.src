use uo;
use os;
use util;

program make_snow_balls (who, scoopsofsnow)

//	DestroyItem(dung);
        if (scoopsofsnow.amount < 3)
            SendSysMessage( who, "Для снежка нужно минимум три пригоршни снега.");
            return;
        endif
        SubtractAmount( scoopsofsnow, 3 );
        CreateItemInContainer(who.backpack, 0x705a, 1);
        SendSysMessage(who, "Вы скатали снежок.");

endprogram