/////////////////////////////////////////////////////////////////////////////
//
// shipCaptain.src - AI капитана корабля (порт из World of Dream).
//
// Стоит на берегу у дока. По слову "sail"/"плыви" показывает меню
// направлений, берёт плату и передаёт игрока скрипту misc/sailto,
// который "везёт" его морем до выбранного города.
//
// Источник: src/WorldOfDream/pkg/npcs/townfolk/merchants/captain.src
// (POL 098); адаптировано под ModernDistro: русские фразы, наша карта
// (доки сверены с realm britannia), outfits через Equipt/sPirate.
//
// Меню направлений — свой гумп, а не CreateMenu: пакет меню (0x7C) передаёт
// текст в CP1252, и кириллица превращалась в "?????". В гумпе строки лежат
// в data-массиве, POL шлёт их сжатым пакетом 0xDD в UTF-16 — кириллица
// отображается нормально.
//
/////////////////////////////////////////////////////////////////////////////

use uo;
use os;
use cfgfile;
use math;

include "include/speech";
include "include/eventID";
include "include/sysEvent";
include ":gumps:gumps";
include ":gumps:gumps_ex";
include ":gumps:yesNo";

var me := Self();

const CAPTAIN_RANGE := 4;
const CAPTAIN_HOME_RANGE := 10;

program ShipCaptain()

	// Одежда (Equipt -> Habille) и имя — как у торговцев, через NPCKeeper.
	Start_Script( "NPCKeeper", me );

	EnableEvents( SYSEVENT_SPEECH + SYSEVENT_ITEM_GIVEN, CAPTAIN_RANGE );

	var home := {me.x, me.y, me.z};

	while( me )
		var ev := os::wait_for_event( 60 );
		if( ev )
			case( ev.type )
				SYSEVENT_SPEECH:
					if( ev.source.IsA( POLCLASS_NPC ) )
						continue;
					endif
					TurnToward( ev.source );
					var text := Lower( ev.text );
					if( text["sail"] || text["плыв"] || text["отплыв"] )
						SailAway( ev.source, text );
					elseif( text["buy"] || text["купить"] )
						Say( "Я ничего не продаю. Хочешь [ПЛЫТЬ] куда-нибудь — только скажи." );
					elseif( text["sell"] || text["продать"] )
						Say( "Мне нужны только хорошее судно и открытое море!" );
					endif
				SYSEVENT_ITEM_GIVEN:
					// Вручённый предмет возвращаем владельцу: капитан не торговец.
					if( ev.item )
						MoveItemToContainer( ev.item, ev.source.backpack );
						Say( "Мне это не нужно, " + ev.source.name + "." );
					endif
			endcase
		endif

		// Держимся у своего дока.
		if( Abs( me.x - home[1] ) + Abs( me.y - home[2] ) > CAPTAIN_HOME_RANGE )
			WalkTowardLocation( home[1], home[2] );
		endif
	endwhile

	return 1;
endprogram


function SailAway( byref who, text )

	var sailto := GetDestination( who, text );
	if( !sailto )
		return;
	endif

	Say( "Значит, хочешь доплыть до " + sailto[5] + "?" );
	Say( "Довезу за " + sailto[6] + " золотых." );

	if( YesNo( who, "Плывём в " + sailto[5] + " за " + sailto[6] + " золотых?", "Да", "Нет" ) )
		if( who.SpendGold( sailto[6] ) )
			SetObjProperty( who, "sailto", sailto );
			Start_Script( "misc/sailto", {who, sailto} );
		else
			Say( "Что-то маловато у тебя золота, приятель." );
		endif
	else
		Say( "Ну нет так нет." );
	endif
endfunction


function DestinationNames()

	return {
		"Британия", "Скара Бре", "Мунглоу", "Магинция",
		"Веспер", "Оккло", "Ну'джельм", "Тринсик",
		"Джелом", "Крепость Змеи", "Коув", "Бухта Пиратов"
	};
endfunction


// parms: [1]x [2]y [3]z [4]duration [5]name [6]cost
function DestinationParams( index )

	case( index )
		1:  return {1499, 1760, -2, 15, "Британии", 100};
		2:  return {662,  2222, 0,  15, "Скара Бре", 100};
		3:  return {4426, 1025, -2, 15, "Мунглоу", 100};
		4:  return {3693, 2297, -2, 15, "Магинции", 100};
		5:  return {3044, 818,  -3, 15, "Веспера", 100};
		6:  return {3662, 2680, -2, 20, "Оккло", 300};
		7:  return {3806, 1278, 5,  20, "Ну'джельма", 300};
		8:  return {2085, 2849, -3, 15, "Тринсика", 100};
		9:  return {1512, 3707, -3, 15, "Джелома", 100};
		10: return {2941, 3413, 1,  20, "Крепости Змеи", 200};
		11: return {2256, 1171, -2, 15, "Коува", 250};
		12: return {2760, 2160, -2, 22, "Бухты Пиратов", 500};
	endcase

	return 0;
endfunction


// Гумп выбора направления. Возвращает 1..12 или 0 при отмене.
function ChooseDestination( player )

	var names := DestinationNames();
	var gump := GFCreateGump( 120, 60, 400, 400 );

	GFResizePic( gump, 0, 0, GFGetCfgConst( "Defaults", "BackGround" ), 400, 400 );
	GFResizePic( gump, 10, 10, GFGetCfgConst( "Defaults", "ForeGround" ), 380, 380 );
	GFTextLine( gump, 130, 22, 1153, "Куда плывём?" );

	var i := 1;
	foreach name in names
		var col := ( i - 1 ) / 6;
		var row := ( i - 1 ) % 6;
		var x := 45 + col * 175;
		var y := 60 + row * 30;
		GFAddButton( gump, x, y, 4005, 4007, GF_CLOSE_BTN, i );
		GFTextLine( gump, x + 30, y + 2, 1153, name );
		i += 1;
		SleepMS( 2 );
	endforeach

	GFAddButton( gump, 160, 355, 4005, 4007, GF_CLOSE_BTN, 0x10 );
	GFTextLine( gump, 190, 357, 1153, "Отмена" );

	var input := GFSendGump( player, gump );
	for k := 1 to 12
		if( input[k] )
			return k;
		endif
	endfor

	return 0;
endfunction


function GetDestination( player, text )

	// Просто "плыви" — показываем меню направлений.
	if( text == "sail" || text == "плыви" || text == "отплыви" || text == "плыть" )
		var index := ChooseDestination( player );
		if( !index )
			return 0;
		endif
		return DestinationParams( index );
	endif

	if( text["britain"] || text["британ"] )
		return DestinationParams( 1 );
	elseif( text["skara"] || text["скара"] )
		return DestinationParams( 2 );
	elseif( text["moonglow"] || text["мунглоу"] )
		return DestinationParams( 3 );
	elseif( text["magincia"] || text["магинция"] )
		return DestinationParams( 4 );
	elseif( text["vesper"] || text["веспер"] )
		return DestinationParams( 5 );
	elseif( text["occlo"] || text["оккло"] )
		return DestinationParams( 6 );
	elseif( text["nujel"] || text["нуджельм"] || text["ну'джельм"] )
		return DestinationParams( 7 );
	elseif( text["trinsic"] || text["тринсик"] )
		return DestinationParams( 8 );
	elseif( text["jhelom"] || text["джелом"] )
		return DestinationParams( 9 );
	elseif( text["hold"] || text["крепость"] || text["змеи"] )
		return DestinationParams( 10 );
	elseif( text["cove"] || text["коув"] )
		return DestinationParams( 11 );
	elseif( text["den"] || text["бухта"] )
		return DestinationParams( 12 );
	endif

	Say( "Я могу доплыть до Британии, Скара Бре, Веспера, Мунглоу, Оккло," );
	SleepMS( 100 );
	Say( "Ну'джельма, Бухты Пиратов, Магинции, Джелома, Крепости Змеи, Коува или Тринсика." );
	return 0;
endfunction
