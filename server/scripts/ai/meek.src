use npc;
use os;
use uo;
use cfgfile;

include "include/eventID";
include "include/sysEvent";
include ":npcs:randName";
include "include/NPCUtil";
include "include/objtype";
include "include/speech";
include "include/anchors";
include "ai/main/mainLoopMeek";
include "ai/combat/fight";
include "ai/combat/defaultCombatEvent";
include "ai/setup/setup";
include "ai/main/loot";
include "ai/main/sleepMode";


const HALT_THRESHOLD := 5; // how close before he attacks?
var npccfgfile := ReadConfigFile( "npcdesc" );
var idlesnd1 := CInt(npccfgfile[me.npctemplate].idlesound1);
var idlesnd2 := CInt(npccfgfile[me.npctemplate].idlesound2);

program KillPlayers()

    	SetWarMode( 0 );

    	main_AI_loop();

endprogram

function CloseDistance( opponent )

    case (Distance( me, opponent ))
        1:              // the most likely, so first
        0:
            return 1;
        default:
            RunToward( opponent );
            return 0;
    endcase

endfunction

function Run( opponent )

    TurnAwayFrom( opponent );

    DisableEvents( SYSEVENT_SPEECH );
    DisableEvents( SYSEVENT_ITEM_GIVEN );

    EnableEvents( SYSEVENT_DISENGAGED );

    var waittime;
    var loops := 0;

    outer:
    while (opponent && !opponent.dead)
	loops := loops + 1;
        waittime := OpenDistance( opponent ) * 15;

	if ( waittime )
		break outer;
	endif

        var ev := wait_for_event( waittime );
        case (ev.type)
            SYSEVENT_DISENGAGED:
                if (ev.source.serial == opponent.serial)
                    say( "Фух!" );
                    break outer;
                endif
            SYSEVENT_ENGAGED:
            SYSEVENT_DAMAGED:
		Spout();
        endcase

	if ( loops > 100 )
		Fight(opponent);
	endif

    endwhile

    DisableEvents( SYSEVENT_DISENGAGED );
    EnableEvents( SYSEVENT_ITEM_GIVEN );
    EnableEvents( SYSEVENT_SPEECH, 2);

    SetWarMode( 0 );

endfunction

function Spout()

	case (RandomInt(60))
	0:	say( "Ай! Оставь меня в покое!" );
	1:	say( "Напади на кого-нибудь своего размера!" );
	2:	say( "Зачем ты это делаешь? ЗАЧЕМ?!" );
	3:	say( "Оставь меня! Я не сделал тебе ничего плохого!" );
	4:	say( "Кал Орт Пор" );
		say( "Проклятье! Нет реагентов...");
	5:	say( "Ах! Я слишком молод, чтобы умирать!" );
	6:	say( "Грубиян! Изверг! А-а-а!" );
	7:	say( "Кто убежал — тот и жив!" );
	8:	say( "Так... драться вздумал? Дерись с кем-нибудь другим!" );
	9:	say( "А-а-а! NPCK!!" );
	10:	say( "Я позову помощь!" );
	11:	say( "Ой! Помогите!!" );
	12:	say( "Спорим, я тебя обгоню!" );
	13:	say( "Стой! Я серьёзно! Просто стой!" );
	14:	say( "А-а-а! Пощади! Прошу, пощади!" );
	15:	say( "Ай! Говорю тебе, я невиновен!" );
	16:	say( "Найди достойного противника!" );
	17:	say( "Я не готов предстать перед создателем!" );
	18:	say( "Подожди! Стой! Я истекаю кровью!" );
	19:	say( "Моя семья отомстит!" );
	20:	say( "Обернись! Что это за ужас?!" );
	21:	say( "Только не по лицу! Не по лицу!" );
	22:	say( "А-а-а! Помогите! Помогите! Я умираю!");
	23:	say( "Клянусь добродетелями! Зачем? ЗАЧЕМ??" );
	24:	say( "Может, если я ещё побегаю, ты запутаешься..." );
	25:	say( "Беги! Прячься! Мы все умрём!" );
	default:	return;
	endcase

	return;

endfunction

function OpenDistance( opponent )

    case (Distance( me, opponent ))
        20:
            return 1;

        default:
            RunAwayFrom( opponent );
            return 0;
    endcase

endfunction