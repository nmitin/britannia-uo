/downloads/
/clientapp/*.dll
/clientapp/*.so*
/clientapp/*.bin.*
/clientapp/*.exe
/clientapp/Data/
/clientapp/settings.json

# Сгенерированные данные мира
/server/realm/
/server/data/
/server/log/
